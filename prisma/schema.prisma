  organizationId     String             @map("organization_id") @db.Uuid
  invoiceId          String             @map("invoice_id") @db.Uuid
  provider           String?
  documentType       String             @map("document_type")
  taxId              String?            @map("tax_id")
  carrierType        String?            @map("carrier_type")
  carrierValueHash   String?            @map("carrier_value_hash")
  status             String             @default("CREATED")
  providerDocumentId String?            @map("provider_document_id")
  issuedAt           DateTime?          @map("issued_at")
  voidedAt           DateTime?          @map("voided_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice            Invoice            @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events             TaxDocumentEvent[]

  @@index([invoiceId, status, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("tax_documents")
}

model TaxDocumentEvent {
  id              String      @id @default(uuid()) @db.Uuid
  taxDocumentId   String      @map("tax_document_id") @db.Uuid
  eventType       String      @map("event_type")
  providerEventId String?     @map("provider_event_id")
  status          String
  occurredAt      DateTime    @default(now()) @map("occurred_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  taxDocument     TaxDocument @relation(fields: [taxDocumentId], references: [id], onDelete: Cascade)

  @@index([taxDocumentId, createdAt])
  @@map("tax_document_events")
}

model BillingNotification {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  notificationType String               @map("notification_type")
  severity         String               @default("INFO")
  status           String               @default("UNREAD")
  title            String
  message          String
  entityType       String?              @map("entity_type")
  entityId         String?              @map("entity_id") @db.Uuid
  dedupeKey        String?              @map("dedupe_key")
  metadataJson     Json?                @map("metadata_json")
  createdAt        DateTime             @default(now()) @map("created_at")
  readAt           DateTime?            @map("read_at")
  dismissedAt      DateTime?            @map("dismissed_at")
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outbox           NotificationOutbox[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("billing_notifications")
}

model NotificationOutbox {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  billingNotificationId String              @map("billing_notification_id") @db.Uuid
  channel               String
  status                String              @default("PENDING")
  availableAt           DateTime            @default(now()) @map("available_at")
  deliveredAt           DateTime?           @map("delivered_at")
  attemptCount          Int                 @default(0) @map("attempt_count")
  lastErrorCode         String?             @map("last_error_code")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingNotification   BillingNotification @relation(fields: [billingNotificationId], references: [id], onDelete: Cascade)

  @@unique([billingNotificationId, channel])
  @@index([status, availableAt])
  @@map("notification_outbox")
}

model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String?      @map("stall_id") @db.Uuid
  email          String
  role           UserRole
  tokenHash      String       @unique @map("token_hash")
  status         String       @default("PENDING")
  invitedById    String?      @map("invited_by") @db.Uuid
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall?       @relation(fields: [stallId], references: [id], onDelete: Cascade)
  invitedBy      Profile?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([tokenHash, status, expiresAt])
  @@map("organization_invitations")
}

model RateLimitBucket {
