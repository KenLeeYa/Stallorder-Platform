generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

enum OrderStatus {
  WAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  MANUAL_TRANSFER
  OTHER

  @@map("payment_method")
}

enum FulfillmentType {
  TAKEOUT
  DINE_IN

  @@map("fulfillment_type")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED

  @@map("order_item_status")
}

enum PaymentOptionKind {
  CASH
  LINE_PAY
  JKO_PAY
  CUSTOM

  @@map("payment_option_kind")
}

enum UserRole {
  PLATFORM_ADMIN
  MERCHANT_OWNER
  MERCHANT_MANAGER
  ORGANIZATION_OWNER
  ORGANIZATION_ADMIN
  FINANCE_VIEWER
  STALL_MANAGER
  STAFF
  KITCHEN

  @@map("user_role")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@map("audit_outcome")
}

enum QrCodeState {
  ACTIVE
  PAUSED
  EXPIRED
  REVOKED

  @@map("qr_code_state")
}

enum OrderSessionStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED

  @@map("order_session_status")
}

enum StallOrderingState {
  OPEN
  PAUSED
  CLOSED

  @@map("stall_ordering_state")
}

enum StallBusinessStatus {
  OPEN
  PAUSED
  CLOSED
  SOLD_OUT

  @@map("stall_business_status")
}

enum PublicAttemptOutcome {
  ALLOWED
  DENIED
  ERROR

  @@map("public_attempt_outcome")
}

model Organization {
  id                     String                    @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                    @unique
  businessName           String                    @map("business_name")
  status                 OrganizationStatus        @default(TRIALING)
  email                  String                    @unique
  phone                  String
  defaultTimezone        String                    @default("Asia/Taipei") @map("default_timezone")
  defaultCurrency        String                    @default("TWD") @map("default_currency")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  stalls                 Stall[]
  memberships            OrganizationMembership[]
  stallMemberships       StallMembership[]
  productCategories      ProductCategory[]
  productGroups          ProductGroup[]
  products               Product[]
  productTranslations    ProductTranslation[]
  stallProducts          StallProduct[]
  diningTables           DiningTable[]
  paymentOptions         PaymentOption[]
  discountOptions        DiscountOption[]
  auditLogs              AuditLog[]
  qrCodes                QrCode[]
  orderingSettings       StallOrderingSettings[]
  orderSessions          OrderSession[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderEvents            OrderEvent[]
  payments               Payment[]
  dailyStallSummaries    DailyStallSummary[]
  operationalEvents      OperationalEvent[]
  operationalAlerts      OperationalAlert[]
  subscription           Subscription?
  additionalApprovals    AdditionalStallApproval[]
  invoices               Invoice[]
  invoiceLineItems       InvoiceLineItem[]
  usageEvents            UsageEvent[]
  invitations            OrganizationInvitation[]
  publicOrderAttempts    PublicOrderAttempt[]
  publicRateLimitBuckets PublicRateLimitBucket[]
  orderCounters          StallOrderCounter[]

  @@map("organizations")
}

model Stall {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  name                   String
  slug                   String                   @unique
  code                   String
  description            String                   @default("")
  address                String
  phone                  String                   @default("")
  timezone               String                   @default("Asia/Taipei")
  currency               String                   @default("TWD")
  isActive               Boolean                  @default(true) @map("is_active")
  businessStatus         StallBusinessStatus      @default(OPEN) @map("business_status")
  orderingEnabled        Boolean                  @default(true) @map("ordering_enabled")
  logoUrl                String?                  @map("logo_url")
  coverImageUrl          String?                  @map("cover_image_url")
  location               String
  orderingState          StallOrderingState       @default(OPEN) @map("ordering_state")
  isSoldOut              Boolean                  @default(false) @map("is_sold_out")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stallProducts          StallProduct[]
  orders                 Order[]
  memberships            StallMembership[]
  auditLogs              AuditLog[]
  qrCodes                QrCode[]
  orderingSettings       StallOrderingSettings?
  diningTables           DiningTable[]
  paymentOptions         PaymentOption[]
  discountOptions        DiscountOption[]
  orderSessions          OrderSession[]
  publicOrderAttempts    PublicOrderAttempt[]
  publicRateLimitBuckets PublicRateLimitBucket[]
  orderCounters          StallOrderCounter[]
  orderEvents            OrderEvent[]
  payments               Payment[]
  dailySummaries         DailyStallSummary[]
  operationalEvents      OperationalEvent[]
  operationalAlerts      OperationalAlert[]
  usageEvents            UsageEvent[]
  invitations            OrganizationInvitation[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, businessStatus])
  @@map("stalls")
}

model Profile {
  id                       String                    @id @default(uuid()) @db.Uuid
  authUserId               String?                   @unique @map("auth_user_id") @db.Uuid
  email                    String                    @unique
  passwordHash             String?                   @map("password_hash")
  displayName              String                    @map("display_name")
  avatarUrl                String?                   @map("avatar_url")
  isActive                 Boolean                   @default(true) @map("is_active")
  lastLoginAt              DateTime?                 @map("last_login_at")
  platformRole             UserRole?                 @map("platform_role")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  organizationMemberships  OrganizationMembership[]
  stallMemberships         StallMembership[]
  sessions                 AuthSession[]
  auditLogs                AuditLog[]
  recordedPayments         Payment[]
  approvedAdditionalStalls AdditionalStallApproval[] @relation("AdditionalStallApprover")
  sentInvitations          OrganizationInvitation[]  @relation("InvitationSender")

  @@map("profiles")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  role           UserRole
  allStalls      Boolean      @default(true) @map("all_stalls")
  isPrimaryOwner Boolean      @default(false) @map("is_primary_owner")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileId, role])
  @@index([profileId, isActive])
  @@index([organizationId, role, isActive])
  @@map("organization_memberships")
}

model StallMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  role           UserRole
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([stallId, profileId, role])
  @@index([stallId, role])
  @@index([organizationId])
  @@map("stall_memberships")
}

model AuthSession {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  csrfTokenHash String   @map("csrf_token_hash")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  stallId        String?       @map("stall_id") @db.Uuid
  actorProfileId String?       @map("actor_profile_id") @db.Uuid
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id") @db.Uuid
  outcome        AuditOutcome
  requestId      String        @map("request_id")
  ipHash         String?       @map("ip_hash")
  metadata       String?
  beforeJson     Json?         @map("before_json")
  afterJson      Json?         @map("after_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall?        @relation(fields: [stallId], references: [id], onDelete: SetNull)
  actor          Profile?      @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([stallId, createdAt])
  @@index([actorProfileId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Plan {
  id                   String         @id @default(uuid()) @db.Uuid
  code                 String         @unique
  displayName          String         @map("display_name")
  basePrice            Int            @default(0) @map("base_price")
  includedStalls       Int            @map("included_stalls")
  additionalStallPrice Int?           @map("additional_stall_price")
  maxStalls            Int?           @map("max_stalls")
  includedOrders       Int?           @map("included_orders")
  excessOrderPrice     Int            @default(0) @map("excess_order_price")
  isActive             Boolean        @default(true) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  subscriptions        Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String                    @unique @map("organization_id") @db.Uuid
  planId              String                    @map("plan_id") @db.Uuid
  status              String                    @default("TRIALING")
  billingPeriodStart  DateTime                  @map("billing_period_start") @db.Date
  billingPeriodEnd    DateTime                  @map("billing_period_end") @db.Date
  cancelAtPeriodEnd   Boolean                   @default(false) @map("cancel_at_period_end")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                Plan                      @relation(fields: [planId], references: [id], onDelete: Restrict)
  additionalApprovals AdditionalStallApproval[]
  invoices            Invoice[]

  @@index([planId, status])
  @@map("subscriptions")
}

model AdditionalStallApproval {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  quantity       Int
  unitPrice      Int          @map("unit_price")
  status         String       @default("APPROVED")
  approvedById   String?      @map("approved_by") @db.Uuid
  reason         String       @default("")
  effectiveAt    DateTime     @default(now()) @map("effective_at")
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  approvedBy     Profile?     @relation("AdditionalStallApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, effectiveAt])
  @@map("additional_stall_approvals")
}

model Invoice {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  subscriptionId     String            @map("subscription_id") @db.Uuid
  invoiceNumber      String            @unique @map("invoice_number")
  status             String            @default("DRAFT")
  currency           String            @default("TWD")
  billingPeriodStart DateTime          @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime          @map("billing_period_end") @db.Date
  subtotal           Int               @default(0)
  total              Int               @default(0)
  issuedAt           DateTime?         @map("issued_at")
  paidAt             DateTime?         @map("paid_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription       Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  lineItems          InvoiceLineItem[]

  @@unique([organizationId, billingPeriodStart, billingPeriodEnd])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  lineType       String       @map("line_type")
  description    String
  quantity       Int
  unitAmount     Int          @map("unit_amount")
  amount         Int
  referenceId    String?      @map("reference_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([organizationId, lineType, createdAt])
  @@map("invoice_line_items")
}

model UsageEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String?      @map("stall_id") @db.Uuid
  eventType      String       @map("event_type")
  quantity       Int
  billingPeriod  DateTime     @map("billing_period") @db.Date
  referenceId    String?      @map("reference_id")
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall?       @relation(fields: [stallId], references: [id], onDelete: SetNull)

  @@index([organizationId, billingPeriod, eventType])
  @@index([stallId, billingPeriod, eventType])
  @@map("usage_events")
}

model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String?      @map("stall_id") @db.Uuid
  email          String
  role           UserRole
  tokenHash      String       @unique @map("token_hash")
  status         String       @default("PENDING")
  invitedById    String?      @map("invited_by") @db.Uuid
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall?       @relation(fields: [stallId], references: [id], onDelete: Cascade)
  invitedBy      Profile?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([tokenHash, status, expiresAt])
  @@map("organization_invitations")
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model ProductCategory {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int            @default(0) @map("sort_order")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groups         ProductGroup[]
  products       Product[]

  @@index([organizationId, sortOrder])
  @@map("product_categories")
}

model ProductGroup {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  name           String
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products       Product[]

  @@index([organizationId, categoryId, sortOrder])
  @@map("product_groups")
}

model Product {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  categoryId     String               @map("category_id") @db.Uuid
  groupId        String?              @map("group_id") @db.Uuid
  name           String
  description    String
  defaultPrice   Int                  @map("default_price")
  imageUrl       String?              @map("image_url")
  isActive       Boolean              @default(true) @map("is_active")
  sortOrder      Int                  @default(0) @map("sort_order")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group          ProductGroup?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  stallProducts  StallProduct[]
  orderItems     OrderItem[]
  translations   ProductTranslation[]

  @@index([organizationId, categoryId, sortOrder])
  @@index([organizationId, groupId])
  @@map("products")
}

model ProductTranslation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  locale         String
  name           String
  description    String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([organizationId, locale])
  @@map("product_translations")
}

model StallProduct {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  priceOverride  Int?         @map("price_override")
  isEnabled      Boolean      @default(true) @map("is_enabled")
  isSoldOut      Boolean      @default(false) @map("is_sold_out")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stallId, productId])
  @@index([organizationId, stallId, isEnabled, isSoldOut])
  @@index([productId, stallId])
  @@map("stall_products")
}

model QrCode {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  stallId             String               @map("stall_id") @db.Uuid
  diningTableId       String?              @map("dining_table_id") @db.Uuid
  token               String               @unique
  label               String
  state               QrCodeState          @default(ACTIVE)
  tokenVersion        Int                  @default(1) @map("token_version")
  expiresAt           DateTime?            @map("expires_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall               Stall                @relation(fields: [stallId], references: [id], onDelete: Cascade)
  diningTable         DiningTable?         @relation(fields: [diningTableId], references: [id], onDelete: Cascade)
  orderSessions       OrderSession[]
  publicOrderAttempts PublicOrderAttempt[]

  @@index([organizationId, stallId])
  @@index([diningTableId, state])
  @@index([stallId, state])
  @@map("qr_codes")
}

model StallOrderingSettings {
  stallId                        String       @id @map("stall_id") @db.Uuid
  organizationId                 String       @map("organization_id") @db.Uuid
  orderSessionTtlSeconds         Int          @default(600) @map("order_session_ttl_seconds")
  unconfirmedOrderTimeoutSeconds Int          @default(600) @map("unconfirmed_order_timeout_seconds")
  maxItemQuantity                Int          @default(20) @map("max_item_quantity")
  maxUniqueProducts              Int          @default(20) @map("max_unique_products")
  maxTotalQuantity               Int          @default(40) @map("max_total_quantity")
  maxNoteLength                  Int          @default(200) @map("max_note_length")
  maxPendingOrdersPerDevice      Int          @default(3) @map("max_pending_orders_per_device")
  maxOrdersPerWindow             Int          @default(5) @map("max_orders_per_window")
  orderWindowSeconds             Int          @default(300) @map("order_window_seconds")
  maxSessionsPerIpWindow         Int          @default(20) @map("max_sessions_per_ip_window")
  maxSessionsPerDeviceWindow     Int          @default(10) @map("max_sessions_per_device_window")
  maxSessionsPerQrWindow         Int          @default(100) @map("max_sessions_per_qr_window")
  maxSessionsPerStallWindow      Int          @default(500) @map("max_sessions_per_stall_window")
  maxBehaviorFrequency           Int          @default(4) @map("max_behavior_frequency")
  dineInEnabled                  Boolean      @default(true) @map("dine_in_enabled")
  printModuleEnabled             Boolean      @default(false) @map("print_module_enabled")
  paymentModuleEnabled           Boolean      @default(true) @map("payment_module_enabled")
  discountModuleEnabled          Boolean      @default(false) @map("discount_module_enabled")
  createdAt                      DateTime     @default(now()) @map("created_at")
  updatedAt                      DateTime     @updatedAt @map("updated_at")
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall                          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("stall_ordering_settings")
}

model DiningTable {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  code           String
  label          String
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)
  qrCodes        QrCode[]
  orders         Order[]

  @@unique([stallId, code])
  @@index([organizationId, stallId, isActive])
  @@map("dining_tables")
}

model PaymentOption {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  stallId        String            @map("stall_id") @db.Uuid
  code           String
  name           String
  kind           PaymentOptionKind
  isEnabled      Boolean           @default(true) @map("is_enabled")
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall             @relation(fields: [stallId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([stallId, code])
  @@index([organizationId, stallId, isEnabled])
  @@map("payment_options")
}

model DiscountOption {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  name           String
  rateBps        Int          @map("rate_bps")
  isEnabled      Boolean      @default(true) @map("is_enabled")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([organizationId, stallId, isEnabled])
  @@map("discount_options")
}

model OrderSession {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  stallId        String             @map("stall_id") @db.Uuid
  qrCodeId       String             @map("qr_code_id") @db.Uuid
  tokenHash      String             @unique @map("token_hash")
  deviceHash     String             @map("device_hash")
  ipHash         String             @map("ip_hash")
  status         OrderSessionStatus @default(ACTIVE)
  expiresAt      DateTime           @map("expires_at")
  usedAt         DateTime?          @map("used_at")
  revokedAt      DateTime?          @map("revoked_at")
  orderId        String?            @unique @map("order_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall              @relation(fields: [stallId], references: [id], onDelete: Cascade)
  qrCode         QrCode             @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  order          Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([stallId, status, expiresAt])
  @@index([deviceHash, status])
  @@map("order_sessions")
}

model Order {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  stallId               String          @map("stall_id") @db.Uuid
  orderNo               String          @map("order_no")
  trackingTokenHash     String          @unique @map("tracking_token_hash")
  idempotencyKey        String          @map("idempotency_key") @db.Uuid
  source                String          @default("QR_MENU")
  customerName          String          @map("customer_name")
  customerPhone         String?         @map("customer_phone")
  tableLabel            String?         @map("table_label")
  diningTableId         String?         @map("dining_table_id") @db.Uuid
  fulfillmentType       FulfillmentType @default(TAKEOUT) @map("fulfillment_type")
  note                  String?
  status                OrderStatus     @default(WAITING_CONFIRMATION)
  paymentStatus         PaymentStatus   @default(UNPAID) @map("payment_status")
  subtotal              Int
  discountAmount        Int             @default(0) @map("discount_amount")
  discountOptionId      String?         @map("discount_option_id") @db.Uuid
  discountLabel         String?         @map("discount_label")
  discountRateBps       Int?            @map("discount_rate_bps")
  total                 Int
  deviceHash            String          @map("device_hash")
  pickupCodeHash        String?         @map("pickup_code_hash")
  pickupVerifiedAt      DateTime?       @map("pickup_verified_at")
  confirmationExpiresAt DateTime        @map("confirmation_expires_at")
  confirmedAt           DateTime?       @map("confirmed_at")
  expiredAt             DateTime?       @map("expired_at")
  completedAt           DateTime?       @map("completed_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  paidAt                DateTime?       @map("paid_at")
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall                 Stall           @relation(fields: [stallId], references: [id], onDelete: Cascade)
  diningTable           DiningTable?    @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  discountOption        DiscountOption? @relation(fields: [discountOptionId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  events                OrderEvent[]
  orderSession          OrderSession?
  payment               Payment?

  @@unique([stallId, orderNo])
  @@unique([stallId, idempotencyKey])
  @@index([organizationId])
  @@index([stallId, status])
  @@index([stallId, createdAt])
  @@index([confirmationExpiresAt, status])
  @@map("orders")
}

model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  stallId         String         @map("stall_id") @db.Uuid
  orderId         String         @unique @map("order_id") @db.Uuid
  paymentOptionId String?        @map("payment_option_id") @db.Uuid
  amount          Int
  method          PaymentMethod  @default(CASH)
  status          PaymentStatus  @default(PAID)
  reference       String?
  methodLabel     String         @default("現金") @map("method_label")
  cashReceived    Int?           @map("cash_received")
  changeAmount    Int?           @map("change_amount")
  recordedById    String?        @map("recorded_by") @db.Uuid
  paidAt          DateTime       @default(now()) @map("paid_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall           Stall          @relation(fields: [stallId], references: [id], onDelete: Cascade)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentOption   PaymentOption? @relation(fields: [paymentOptionId], references: [id], onDelete: SetNull)
  recordedBy      Profile?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId, stallId, paidAt])
  @@index([status, method, paidAt])
  @@index([recordedById, paidAt])
  @@map("payments")
}

model DailyStallSummary {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  stallId              String       @map("stall_id") @db.Uuid
  businessDate         DateTime     @map("business_date") @db.Date
  orderCount           Int          @default(0) @map("order_count")
  confirmedOrderCount  Int          @default(0) @map("confirmed_order_count")
  completedOrderCount  Int          @default(0) @map("completed_order_count")
  cancelledOrderCount  Int          @default(0) @map("cancelled_order_count")
  pendingOrderCount    Int          @default(0) @map("pending_order_count")
  unpaidOrderCount     Int          @default(0) @map("unpaid_order_count")
  grossSales           Int          @default(0) @map("gross_sales")
  discountAmount       Int          @default(0) @map("discount_amount")
  netSales             Int          @default(0) @map("net_sales")
  cashAmount           Int          @default(0) @map("cash_amount")
  manualTransferAmount Int          @default(0) @map("manual_transfer_amount")
  otherPaymentAmount   Int          @default(0) @map("other_payment_amount")
  averageOrderValue    Int          @default(0) @map("average_order_value")
  lastOrderAt          DateTime?    @map("last_order_at")
  lastCalculatedAt     DateTime     @default(now()) @map("last_calculated_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall                Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([stallId, businessDate])
  @@index([organizationId, businessDate, stallId])
  @@index([stallId, businessDate(sort: Desc)])
  @@map("daily_stall_summaries")
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  stallId        String          @map("stall_id") @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  productId      String?         @map("product_id") @db.Uuid
  name           String
  unitPrice      Int             @map("unit_price")
  quantity       Int
  note           String?
  status         OrderItemStatus @default(PENDING)
  preparingAt    DateTime?       @map("preparing_at")
  readyAt        DateTime?       @map("ready_at")
  servedAt       DateTime?       @map("served_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId, stallId])
  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  eventType      String       @map("event_type")
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus? @map("new_status")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([stallId, createdAt(sort: Desc)])
  @@index([orderId, createdAt])
  @@map("order_events")
}

model OperationalEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  eventType      String       @map("event_type")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id") @db.Uuid
  payload        Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([stallId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("operational_events")
}

model OperationalAlert {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  alertType      String       @map("alert_type")
  severity       String
  message        String
  status         String       @default("ACTIVE")
  detectedAt     DateTime     @default(now()) @map("detected_at")
  acknowledgedAt DateTime?    @map("acknowledged_at")
  resolvedAt     DateTime?    @map("resolved_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, detectedAt(sort: Desc)])
  @@index([stallId, status, detectedAt(sort: Desc)])
  @@map("operational_alerts")
}

model PublicOrderAttempt {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String?              @map("organization_id") @db.Uuid
  stallId          String?              @map("stall_id") @db.Uuid
  qrCodeId         String?              @map("qr_code_id") @db.Uuid
  orderSessionId   String?              @map("order_session_id") @db.Uuid
  requestId        String               @map("request_id")
  eventType        String               @map("event_type")
  outcome          PublicAttemptOutcome
  reasonCode       String               @map("reason_code")
  ipHash           String?              @map("ip_hash")
  deviceHash       String?              @map("device_hash")
  qrTokenHash      String?              @map("qr_token_hash")
  orderSessionHash String?              @map("order_session_hash")
  behaviorHash     String?              @map("behavior_hash")
  idempotencyHash  String?              @map("idempotency_hash")
  createdAt        DateTime             @default(now()) @map("created_at")
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall            Stall?               @relation(fields: [stallId], references: [id], onDelete: SetNull)
  qrCode           QrCode?              @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([stallId, createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@map("public_order_attempts")
}

model PublicRateLimitBucket {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  dimensionType  String       @map("dimension_type")
  dimensionHash  String       @map("dimension_hash")
  windowStart    DateTime     @map("window_start")
  count          Int          @default(0)
  expiresAt      DateTime     @map("expires_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([stallId, dimensionType, dimensionHash, windowStart])
  @@index([organizationId, expiresAt])
  @@index([expiresAt])
  @@map("public_rate_limit_buckets")
}

model StallOrderCounter {
  stallId        String       @map("stall_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  businessDate   DateTime     @map("business_date") @db.Date
  nextValue      Int          @default(1) @map("next_value")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@id([stallId, businessDate])
  @@index([organizationId, businessDate])
  @@map("stall_order_counters")
}
