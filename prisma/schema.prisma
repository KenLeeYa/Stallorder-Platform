model QrCode {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  stallId             String               @map("stall_id") @db.Uuid
  diningTableId       String?              @map("dining_table_id") @db.Uuid
  locationId          String?              @map("location_id") @db.Uuid
  marketEventId       String?              @map("market_event_id") @db.Uuid
  stallScheduleId     String?              @map("stall_schedule_id") @db.Uuid
  fulfillmentTypeContext FulfillmentType?  @map("fulfillment_type_context")
  token               String               @unique
  label               String
  state               QrCodeState          @default(ACTIVE)
  tokenVersion        Int                  @default(1) @map("token_version")
  expiresAt           DateTime?            @map("expires_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall               Stall                @relation(fields: [stallId], references: [id], onDelete: Cascade)
  diningTable         DiningTable?         @relation(fields: [diningTableId], references: [id], onDelete: Cascade)
  location            StallLocation?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  marketEvent         MarketEvent?         @relation(fields: [marketEventId], references: [id], onDelete: Restrict)
  stallSchedule       StallSchedule?       @relation(fields: [stallScheduleId], references: [id], onDelete: Restrict)
  orderSessions       OrderSession[]
  publicOrderAttempts PublicOrderAttempt[]
  merchantSetupProgress MerchantSetupProgress?

  @@index([organizationId, stallId])
  @@index([diningTableId, state])
  @@index([stallScheduleId, state])
  @@index([locationId, state])
  @@index([marketEventId, state])
  @@index([stallId, state])
  @@map("qr_codes")
}

