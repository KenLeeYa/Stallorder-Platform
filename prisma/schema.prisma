generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

enum OrderStatus {
  WAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  PACKING
  READY
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  MANUAL_TRANSFER
  OTHER

  @@map("payment_method")
}

enum FulfillmentType {
  TAKEOUT
  DINE_IN
  DELIVERY

  @@map("fulfillment_type")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED

  @@map("order_item_status")
}

enum KitchenTaskStatus {
  PENDING
  PREPARING
  COMPLETED
  CANCELLED

  @@map("kitchen_task_status")
}

enum ProductNoteSelectionMode {
  SINGLE
  MULTIPLE

  @@map("product_note_selection_mode")
}

enum PaymentOptionKind {
  CASH
  LINE_PAY
  JKO_PAY
  CUSTOM

  @@map("payment_option_kind")
}

enum UserRole {
  PLATFORM_ADMIN
  MERCHANT_OWNER
  MERCHANT_MANAGER
  ORGANIZATION_OWNER
  ORGANIZATION_ADMIN
  FINANCE_VIEWER
  STALL_MANAGER
  STAFF
  KITCHEN

  @@map("user_role")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@map("audit_outcome")
}

enum MerchantApplicationStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@map("merchant_application_status")
}

enum MerchantApplicationRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED

  @@map("merchant_application_risk_level")
}

enum MerchantBusinessType {
  NIGHT_MARKET_STALL
  FOOD_TRUCK
  MARKET_STALL
  POPUP_STORE
  SMALL_RESTAURANT
  BEVERAGE_SHOP
  OTHER

  @@map("merchant_business_type")
}

enum PreferredContactMethod {
  PHONE
  LINE
  EMAIL

  @@map("preferred_contact_method")
}

enum QrCodeState {
  ACTIVE
  PAUSED
  EXPIRED
  REVOKED

  @@map("qr_code_state")
}

enum OrderSessionStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED

  @@map("order_session_status")
}

enum StallOrderingState {
  OPEN
  PAUSED
  CLOSED

  @@map("stall_ordering_state")
}

enum StallBusinessStatus {
  OPEN
  PAUSED
  CLOSED
  SOLD_OUT

  @@map("stall_business_status")
}

enum DiningTableServiceState {
  EMPTY
  OCCUPIED
  NEEDS_CLEANING

  @@map("dining_table_service_state")
}

enum CancellationReason {
  SOLD_OUT
  CUSTOMER_CANCELLED
  WAIT_TOO_LONG
  DUPLICATE_ORDER
  OTHER

  @@map("cancellation_reason")
}

enum PrintJobStatus {
  PENDING
  PRINTING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("print_job_status")
}

enum CashShiftStatus {
  OPEN
  CLOSED

  @@map("cash_shift_status")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT

  @@map("cash_movement_type")
}

enum PublicAttemptOutcome {
  ALLOWED
  DENIED
  ERROR

  @@map("public_attempt_outcome")
}

enum ReportScheduleType {
  DAILY_SALES
  WEEKLY_SALES
  PAYMENT_VARIANCE

  @@map("report_schedule_type")
}

enum ReportDeliveryStatus {
  PROCESSING
  SENT
  SIMULATED
  FAILURE

  @@map("report_delivery_status")
}

model Organization {
  id                            String                         @id @default(uuid()) @db.Uuid
  name                          String
  slug                          String                         @unique
  businessName                  String                         @map("business_name")
  status                        OrganizationStatus             @default(TRIALING)
  email                         String                         @unique
  phone                         String
  defaultTimezone               String                         @default("Asia/Taipei") @map("default_timezone")
  defaultCurrency               String                         @default("TWD") @map("default_currency")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  stalls                        Stall[]
  memberships                   OrganizationMembership[]
  stallMemberships              StallMembership[]
  productCategories             ProductCategory[]
  productGroups                 ProductGroup[]
  products                      Product[]
  productTranslations           ProductTranslation[]
  productNoteGroups             ProductNoteGroup[]
  productNoteOptions            ProductNoteOption[]
  productNoteGroupTranslations  ProductNoteGroupTranslation[]
  productNoteOptionTranslations ProductNoteOptionTranslation[]
  productNoteAssignments        ProductNoteGroupAssignment[]
  stallProducts                 StallProduct[]
  diningTables                  DiningTable[]
  paymentOptions                PaymentOption[]
  discountOptions               DiscountOption[]
  auditLogs                     AuditLog[]
  qrCodes                       QrCode[]
  orderingSettings              StallOrderingSettings[]
  orderSessions                 OrderSession[]
  orders                        Order[]
  orderItems                    OrderItem[]
  orderItemNoteOptions          OrderItemNoteOption[]
  orderEvents                   OrderEvent[]
  payments                      Payment[]
  dailyStallSummaries           DailyStallSummary[]
  operationalEvents             OperationalEvent[]
  operationalAlerts             OperationalAlert[]
  subscription                  Subscription?
  additionalApprovals           AdditionalStallApproval[]
  invoices                      Invoice[]
  invoiceLineItems              InvoiceLineItem[]
  usageEvents                   UsageEvent[]
  subscriptionItems             SubscriptionItem[]
  manualPaymentRecords          ManualPaymentRecord[]
  billingUsageSummaries         BillingUsageSummary[]
  billingNotifications          BillingNotification[]
  notificationOutbox            NotificationOutbox[]
  billingChangeRequests         BillingChangeRequest[]
  paymentProviderCustomers      PaymentProviderCustomer[]
  paymentAttempts               PaymentAttempt[]
  taxDocuments                  TaxDocument[]
  invitations                   OrganizationInvitation[]
  publicOrderAttempts           PublicOrderAttempt[]
  publicRateLimitBuckets        PublicRateLimitBucket[]
  orderCounters                 StallOrderCounter[]
  orderItemBatchActions         OrderItemBatchAction[]
  businessHours                 StallBusinessHour[]
  printers                      Printer[]
  printJobs                     PrintJob[]
  cashShifts                    CashShift[]
  cashMovements                 CashMovement[]
  checkoutGroups                CheckoutGroup[]
  reportSchedules               ReportSchedule[]
  reportDeliveries              ReportDelivery[]
  approvedMerchantApplication   MerchantApplication?
  merchantSetupProgress         MerchantSetupProgress?
  kitchenStations               KitchenStation[]
  kitchenStationAssignments     KitchenStationAssignment[]
  productionTasks               OrderProductionTask[]
  pickupDisplaySettings         PickupDisplaySettings[]

  @@map("organizations")
}

model Stall {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  name                   String
  slug                   String                   @unique
  code                   String
  description            String                   @default("")
  address                String
  phone                  String                   @default("")
  timezone               String                   @default("Asia/Taipei")
  currency               String                   @default("TWD")
  isActive               Boolean                  @default(true) @map("is_active")
  businessStatus         StallBusinessStatus      @default(OPEN) @map("business_status")
  orderingEnabled        Boolean                  @default(true) @map("ordering_enabled")
  logoUrl                String?                  @map("logo_url")
  coverImageUrl          String?                  @map("cover_image_url")
  location               String
  orderingState          StallOrderingState       @default(OPEN) @map("ordering_state")
  isSoldOut              Boolean                  @default(false) @map("is_sold_out")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stallProducts          StallProduct[]
  orders                 Order[]
  orderItemNoteOptions   OrderItemNoteOption[]
  memberships            StallMembership[]
  auditLogs              AuditLog[]
  qrCodes                QrCode[]
  orderingSettings       StallOrderingSettings?
  diningTables           DiningTable[]
  paymentOptions         PaymentOption[]
  discountOptions        DiscountOption[]
  orderSessions          OrderSession[]
  publicOrderAttempts    PublicOrderAttempt[]
  publicRateLimitBuckets PublicRateLimitBucket[]
  orderCounters          StallOrderCounter[]
  orderEvents            OrderEvent[]
  payments               Payment[]
  dailySummaries         DailyStallSummary[]
  operationalEvents      OperationalEvent[]
  operationalAlerts      OperationalAlert[]
  usageEvents            UsageEvent[]
  invitations            OrganizationInvitation[]
  orderItemBatchActions  OrderItemBatchAction[]
  businessHours          StallBusinessHour[]
  printers               Printer[]
  printJobs              PrintJob[]
  cashShifts             CashShift[]
  cashMovements          CashMovement[]
  checkoutGroups         CheckoutGroup[]
  merchantSetupProgress  MerchantSetupProgress?
  kitchenStations        KitchenStation[]
  kitchenStationAssignments KitchenStationAssignment[]
  productionTasks        OrderProductionTask[]
  pickupDisplaySettings  PickupDisplaySettings?

  @@unique([organizationId, code])
  @@index([organizationId, isActive, businessStatus])
  @@map("stalls")
}

model Profile {
  id                       String                    @id @default(uuid()) @db.Uuid
  authUserId               String?                   @unique @map("auth_user_id") @db.Uuid
  email                    String                    @unique
  passwordHash             String?                   @map("password_hash")
  displayName              String                    @map("display_name")
  avatarUrl                String?                   @map("avatar_url")
  isActive                 Boolean                   @default(true) @map("is_active")
  lastLoginAt              DateTime?                 @map("last_login_at")
  platformRole             UserRole?                 @map("platform_role")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  organizationMemberships  OrganizationMembership[]
  stallMemberships         StallMembership[]
  sessions                 AuthSession[]
  auditLogs                AuditLog[]
  recordedPayments         Payment[]
  approvedAdditionalStalls AdditionalStallApproval[] @relation("AdditionalStallApprover")
  createdPlanVersions      PlanVersion[]              @relation("PlanVersionCreatedBy")
  recordedManualPayments   ManualPaymentRecord[]      @relation("ManualPaymentRecordedBy")
  verifiedManualPayments   ManualPaymentRecord[]      @relation("ManualPaymentVerifiedBy")
  requestedBillingChanges  BillingChangeRequest[]     @relation("BillingChangeRequestedBy")
  decidedBillingChanges    BillingChangeRequest[]     @relation("BillingChangeDecidedBy")
  sentInvitations          OrganizationInvitation[]  @relation("InvitationSender")
  orderItemBatchActions    OrderItemBatchAction[]
  requestedPrintJobs       PrintJob[]                @relation("PrintJobRequestedBy")
  openedCashShifts         CashShift[]               @relation("CashShiftOpenedBy")
  closedCashShifts         CashShift[]               @relation("CashShiftClosedBy")
  cashMovements            CashMovement[]
  checkoutGroups           CheckoutGroup[]
  discountAppliedOrders    Order[]                   @relation("DiscountAppliedBy")
  discountApprovedOrders   Order[]                   @relation("DiscountApprovedBy")
  cancelledOrders          Order[]                   @relation("OrderCancelledBy")
  createdReportSchedules   ReportSchedule[]          @relation("ReportScheduleCreatedBy")
  updatedReportSchedules   ReportSchedule[]          @relation("ReportScheduleUpdatedBy")
  merchantApplications     MerchantApplication[]             @relation("MerchantApplicationApplicant")
  assignedApplications     MerchantApplication[]             @relation("MerchantApplicationAssignedReviewer")
  reviewedApplications     MerchantApplication[]             @relation("MerchantApplicationReviewer")
  applicationNotifications MerchantApplicationNotification[]
  completedMerchantSetups  MerchantSetupProgress[]           @relation("MerchantSetupCompletedBy")
  activatedMerchantSetups  MerchantSetupProgress[]           @relation("MerchantSetupActivatedBy")
  assignedProductionTasks  OrderProductionTask[]

  @@map("profiles")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  role           UserRole
  allStalls      Boolean      @default(true) @map("all_stalls")
  isPrimaryOwner Boolean      @default(false) @map("is_primary_owner")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileId, role])
  @@index([profileId, isActive])
  @@index([organizationId, role, isActive])
  @@map("organization_memberships")
}

model StallMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  stallId        String       @map("stall_id") @db.Uuid
  role           UserRole
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stall          Stall        @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([stallId, profileId, role])
  @@index([stallId, role])
  @@index([organizationId])
  @@map("stall_memberships")
}

model AuthSession {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  csrfTokenHash String   @map("csrf_token_hash")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  stallId        String?       @map("stall_id") @db.Uuid
  actorProfileId String?       @map("actor_profile_id") @db.Uuid
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id") @db.Uuid
  outcome        AuditOutcome
  requestId      String        @map("request_id")
  ipHash         String?       @map("ip_hash")
  metadata       String?
  beforeJson     Json?         @map("before_json")
  afterJson      Json?         @map("after_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall          Stall?        @relation(fields: [stallId], references: [id], onDelete: SetNull)
  actor          Profile?      @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([stallId, createdAt])
  @@index([actorProfileId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model MerchantApplication {
  id                             String                            @id @default(uuid()) @db.Uuid
  applicationNumber              String                            @unique @default(dbgenerated("next_merchant_application_number()")) @map("application_number")
  applicantProfileId             String                            @map("applicant_profile_id") @db.Uuid
  applicantEmail                 String                            @map("applicant_email")
  applicantDisplayName           String                            @map("applicant_display_name")
  merchantName                   String?                           @map("merchant_name")
  businessType                   MerchantBusinessType?             @map("business_type")
  businessRegistrationNumber     String?                           @map("business_registration_number")
  businessRegistrationNumberHash String?                           @map("business_registration_number_hash")
  contactName                    String?                           @map("contact_name")
  phone                          String?
  phoneHash                      String?                           @map("phone_hash")
  businessPhone                  String?                           @map("business_phone")
  lineId                         String?                           @map("line_id")
  preferredContactMethod         PreferredContactMethod?           @map("preferred_contact_method")
  businessAddress                String?                           @map("business_address")
  city                           String?
  merchantDescription            String?                           @map("merchant_description")
  stallName                      String?                           @map("stall_name")
  stallLocation                  String?                           @map("stall_location")
  requestedSlug                  String?                           @map("requested_slug")
  estimatedDailyOrders           Int?                              @map("estimated_daily_orders")
  expectedStartDate              DateTime?                         @map("expected_start_date") @db.Date
  needsMultipleStaff             Boolean                           @default(false) @map("needs_multiple_staff")
  needsKitchenView               Boolean                           @default(false) @map("needs_kitchen_view")
  requestedPlanCode              String                            @default("TRIAL") @map("requested_plan_code")
  status                         MerchantApplicationStatus         @default(DRAFT)
  riskLevel                      MerchantApplicationRiskLevel      @default(LOW) @map("risk_level")
  riskReasonsJson                Json?                             @map("risk_reasons_json")
  publicReviewNote               String?                           @map("public_review_note")
  internalReviewNote             String?                           @map("internal_review_note")
  currentStep                    Int                               @default(1) @map("current_step")
  termsAccepted                  Boolean                           @default(false) @map("terms_accepted")
  privacyAccepted                Boolean                           @default(false) @map("privacy_accepted")
  dataProcessingAccepted         Boolean                           @default(false) @map("data_processing_accepted")
  informationConfirmed           Boolean                           @default(false) @map("information_confirmed")
  consentedAt                    DateTime?                         @map("consented_at")
  submissionIpHash               String?                           @map("submission_ip_hash")
  submissionDeviceHash           String?                           @map("submission_device_hash")
  submittedAt                    DateTime?                         @map("submitted_at")
  assignedReviewerProfileId      String?                           @map("assigned_reviewer_profile_id") @db.Uuid
  reviewedAt                     DateTime?                         @map("reviewed_at")
  reviewedByProfileId            String?                           @map("reviewed_by_profile_id") @db.Uuid
  approvedAt                     DateTime?                         @map("approved_at")
  approvedOrganizationId         String?                           @unique @map("approved_organization_id") @db.Uuid
  rejectedAt                     DateTime?                         @map("rejected_at")
  withdrawnAt                    DateTime?                         @map("withdrawn_at")
  expiresAt                      DateTime?                         @map("expires_at")
  reapplicationAllowed           Boolean                           @default(false) @map("reapplication_allowed")
  createdAt                      DateTime                          @default(now()) @map("created_at")
  updatedAt                      DateTime                          @updatedAt @map("updated_at")
  applicant                      Profile                           @relation("MerchantApplicationApplicant", fields: [applicantProfileId], references: [id], onDelete: Restrict)
  assignedReviewer               Profile?                          @relation("MerchantApplicationAssignedReviewer", fields: [assignedReviewerProfileId], references: [id], onDelete: SetNull)
  reviewedBy                     Profile?                          @relation("MerchantApplicationReviewer", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)
  approvedOrganization           Organization?                     @relation(fields: [approvedOrganizationId], references: [id], onDelete: SetNull)
  notifications                  MerchantApplicationNotification[]
  setupProgress                  MerchantSetupProgress?

  @@index([applicantProfileId, status, createdAt(sort: Desc)])
  @@index([status, submittedAt, createdAt])
  @@index([assignedReviewerProfileId, status, submittedAt])
  @@index([phoneHash, status])
  @@index([businessRegistrationNumberHash, status])
  @@index([requestedSlug, status])
  @@map("merchant_applications")
}

model MerchantApplicationNotification {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  profileId     String              @map("profile_id") @db.Uuid
  type          String
  title         String
  message       String
  readAt        DateTime?           @map("read_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  application   MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  profile       Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, readAt, createdAt(sort: Desc)])
  @@index([applicationId, createdAt(sort: Desc)])
  @@map("merchant_application_notifications")
}

model MerchantSetupProgress {
  id                       String              @id @default(uuid()) @db.Uuid
  applicationId            String              @unique @map("application_id") @db.Uuid
  organizationId           String              @unique @map("organization_id") @db.Uuid
  stallId                  String              @unique @map("stall_id") @db.Uuid
  qrCodeId                 String              @unique @map("qr_code_id") @db.Uuid
  currentStep              Int                 @default(1) @map("current_step")
  merchantProfileCompleted Boolean             @default(false) @map("merchant_profile_completed")
  stallProfileCompleted    Boolean             @default(false) @map("stall_profile_completed")
  catalogCompleted         Boolean             @default(false) @map("catalog_completed")
  paymentOptionsCompleted  Boolean             @default(false) @map("payment_options_completed")
  teamSetupCompleted       Boolean             @default(false) @map("team_setup_completed")
  qrPreviewCompleted       Boolean             @default(false) @map("qr_preview_completed")
  testOrderCompleted       Boolean             @default(false) @map("test_order_completed")
  testOrderId              String?             @unique @map("test_order_id") @db.Uuid
  goLiveCompleted          Boolean             @default(false) @map("go_live_completed")
  testOrderCompletedAt     DateTime?           @map("test_order_completed_at")
  goLiveCompletedAt        DateTime?           @map("go_live_completed_at")
  completedAt              DateTime?           @map("completed_at")
  completedByProfileId     String?             @map("completed_by_profile_id") @db.Uuid
  activatedByProfileId     String?             @map("activated_by_profile_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  application              MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stall                    Stall               @relation(fields: [stallId], references: [id], onDelete: Cascade)
  qrCode                   QrCode              @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  testOrder                Order?              @relation("MerchantSetupTestOrder", fields: [testOrderId], references: [id], onDelete: Restrict)
  completedBy              Profile?            @relation("MerchantSetupCompletedBy", fields: [completedByProfileId], references: [id], onDelete: SetNull)
  activatedBy              Profile?            @relation("MerchantSetupActivatedBy", fields: [activatedByProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, goLiveCompleted])
  @@index([stallId, testOrderCompleted])
  @@map("merchant_setup_progress")
}

model ReportSchedule {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  reportType     ReportScheduleType @map("report_type")
  recipients     String[]
  stallIds       String[]           @map("stall_ids") @db.Uuid
  timezone       String             @default("Asia/Taipei")
  sendHour       Int                @default(8) @map("send_hour") @db.SmallInt
  sendMinute     Int                @default(0) @map("send_minute") @db.SmallInt
  dayOfWeek      Int?               @map("day_of_week") @db.SmallInt
  isEnabled      Boolean            @default(true) @map("is_enabled")
  nextRunAt      DateTime           @map("next_run_at")
  lastRunAt      DateTime?          @map("last_run_at")
  archivedAt     DateTime?          @map("archived_at")
  createdById    String             @map("created_by") @db.Uuid
  updatedById    String             @map("updated_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      Profile            @relation("ReportScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      Profile            @relation("ReportScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deliveries     ReportDelivery[]

  @@index([organizationId, isEnabled, archivedAt])
  @@index([isEnabled, archivedAt, nextRunAt])
  @@map("report_schedules")
}

model ReportDelivery {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  reportScheduleId  String               @map("report_schedule_id") @db.Uuid
  reportType        ReportScheduleType   @map("report_type")
  status            ReportDeliveryStatus @default(PROCESSING)
  scheduledFor      DateTime             @map("scheduled_for")
  periodStart       DateTime             @map("period_start") @db.Date
  periodEnd         DateTime             @map("period_end") @db.Date
  recipients        String[]
  subject           String
  payload           Json?
  attemptCount      Int                  @default(1) @map("attempt_count")
  providerMessageId String?              @map("provider_message_id")
  errorCode         String?              @map("error_code")
  startedAt         DateTime             @default(now()) @map("started_at")
  sentAt            DateTime?            @map("sent_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportSchedule    ReportSchedule       @relation(fields: [reportScheduleId], references: [id], onDelete: Restrict)

