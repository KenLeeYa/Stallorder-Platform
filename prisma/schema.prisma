model Product {
  id                   String                       @id @default(uuid()) @db.Uuid
  organizationId       String                       @map("organization_id") @db.Uuid
  categoryId           String                       @map("category_id") @db.Uuid
  groupId              String?                      @map("group_id") @db.Uuid
  name                 String
  description          String
  defaultPrice         Int                          @map("default_price")
  imageUrl             String?                      @map("image_url")
  isActive             Boolean                      @default(true) @map("is_active")
  sortOrder            Int                          @default(0) @map("sort_order")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             ProductCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group                ProductGroup?                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  stallProducts        StallProduct[]
  orderItems           OrderItem[]
  translations         ProductTranslation[]
  noteGroupAssignments ProductNoteGroupAssignment[]
  kitchenStationAssignments KitchenStationAssignment[]
  capacityRules         ProductCapacityRule[]

  @@index([organizationId, categoryId, sortOrder])
  @@index([organizationId, groupId])
  @@map("products")
}

