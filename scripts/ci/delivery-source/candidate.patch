@@ -0,0 +1,188 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { Children, isValidElement, type ReactElement, type ReactNode } from 'react';
+import { publicOrderMessages } from '@/lib/messages/public-order';
+
+type OrderStatus = 'WAITING_CONFIRMATION' | 'CONFIRMED' | 'PREPARING' | 'PACKING' | 'READY' | 'COMPLETED' | 'CANCELLED' | 'EXPIRED';
+type Fulfillment = 'TAKEOUT' | 'DINE_IN' | 'DELIVERY';
+type Order = ReturnType<typeof order>;
+
+const shared = await vi.hoisted(async () => {
+  const { createHookRuntime } = await import('../test/stateful-hook-runtime');
+  return {
+    runtime: createHookRuntime(),
+    onData: undefined as undefined | ((value: Order) => void),
+    refresh: vi.fn(async () => undefined),
+    play: vi.fn(async () => undefined),
+  };
+});
+
+// This exercises the real component callbacks and returned JSX. The deterministic
+// hook runtime is not React scheduling, hydration, DOM, or browser acceptance.
+vi.mock('react', async (importOriginal) => ({
+  ...await importOriginal<typeof import('react')>(),
+  ...shared.runtime.hooks,
+}));
+vi.mock('@/lib/use-live-resource', () => ({
+  LiveResourceRetryError: class extends Error {},
+  useLiveResource: (options: { onData: (value: Order) => void }) => {
+    shared.onData = options.onData;
+    return { refresh: shared.refresh };
+  },
+}));
+vi.mock('@/components/locale-provider', () => ({ useAppLocale: () => ({ locale: 'zh-TW' }) }));
+vi.mock('@/components/line-notification-controls', () => ({ LineNotificationControls: () => null }));
+vi.mock('@/components/public-order-feedback-dialog', () => ({ PublicOrderFeedbackDialog: () => null }));
+vi.mock('@/components/public-order-closure-notice', () => ({ PublicOrderClosureNotice: () => null }));
+vi.mock('@/lib/browser-alert-sound', () => ({
+  playAlertSound: shared.play,
+  primeAlertSound: vi.fn(async () => undefined),
+}));
+vi.mock('@/lib/public-order-client', () => ({
+  getOrCreateDeviceId: () => '11111111-1111-4111-8111-111111111111',
+  createPublicOrderOperationId: () => '22222222-2222-4222-8222-222222222222',
+  publicOrderCircuitHeaders: () => ({}),
+  parseEdgeResponse: (response: Response) => response.json(),
+  requestPublicOrder: () => { throw new Error('Unexpected request: this contract test has no live API'); },
+  respondToFulfillmentTime: () => { throw new Error('Unexpected fulfillment response'); },
+}));
+
+import { PublicOrderCancelDialog, PublicOrderTracker } from './public-order-tracker';
+
+function order(orderStatus: OrderStatus = 'READY', fulfillmentType: Fulfillment = 'TAKEOUT') {
+  return {
+    orderNo: 'SYNTHETIC-PICKUP-0001', orderStatus, fulfillmentType,
+    paymentStatus: 'UNPAID' as const, totalAmount: 95, currency: 'TWD',
+    createdAt: '2026-10-28T00:00:00.000Z', confirmedAt: null, completedAt: null,
+    stallName: 'Synthetic Pickup Fixture', publicMenuIdentifier: null,
+    pickupVerificationCode: '2468' as string | null, tableLabel: null,
+    customerPhone: null, deliveryAddress: null, estimatedWaitMinutes: 10,
+    quotedWaitMinutes: null, quotedReadyAt: null, lastTableOrderAt: null,
+    stallTimezone: 'Asia/Taipei', requestedFulfillmentAt: null,
+    committedFulfillmentAt: null, pendingFulfillmentAt: null,
+    fulfillmentTimeState: 'NOT_REQUESTED' as const, fulfillmentTimeVersion: 0,
+    fulfillmentTimeResponseExpiresAt: null, fulfillmentTimeChangeReason: null,
+    merchantAmendment: null,
+    items: [{ id: 'synthetic-item-1', name: 'Synthetic tea', quantity: 1,
+      note: null, noteOptions: [], status: 'READY' as const }],
+  };
+}
+
+type Element = ReactElement<Record<string, unknown>>;
+function elements(node: ReactNode): Element[] {
+  return Children.toArray(node).flatMap(child => {
+    if (!isValidElement<Record<string, unknown>>(child)) return [];
+    return [child, ...elements(child.props.children as ReactNode)];
+  });
+}
+function text(node: ReactNode): string {
+  return Children.toArray(node).map(child => isValidElement<Record<string, unknown>>(child)
+    ? text(child.props.children as ReactNode) : String(child)).join('');
+}
+function render() {
+  return shared.runtime.render(() => PublicOrderTracker({ trackingToken: 'synthetic-tracking-token' }));
+}
+function receive(value: Order) {
+  expect(shared.onData).toBeTypeOf('function');
+  shared.onData!(value);
+  return render();
+}
+function pickupDialogs(tree: ReactNode) {
+  return elements(tree).filter(element => element.props['aria-labelledby'] === 'pickup-ready-dialog-title');
+}
+function click(element: Element) {
+  expect(element.props.onClick).toBeTypeOf('function');
+  (element.props.onClick as () => void)();
+}
+
+describe('pickup readiness component contract', () => {
+  beforeEach(() => {
+    shared.runtime.reset();
+    shared.onData = undefined;
+    shared.refresh.mockClear();
+    shared.play.mockClear();
+    vi.stubGlobal('window', new EventTarget());
+    vi.stubGlobal('fetch', vi.fn(() => { throw new Error('Unexpected network request'); }));
+    render();
+  });
+  afterEach(() => {
+    shared.runtime.stop();
+    vi.unstubAllGlobals();
+  });
+
+  it('shows the current TAKEOUT READY code and announces it once', () => {
+    const tree = receive(order());
+    expect(pickupDialogs(tree)).toHaveLength(1);
+    const code = elements(tree).find(element => element.props['data-testid'] === 'pickup-ready-dialog-code');
+    expect(text(code!.props.children as ReactNode)).toBe('2468');
+    receive(order());
+    expect(shared.play).toHaveBeenCalledExactlyOnceWith({ preset: 'URGENT', volume: 100, repeatCount: 3 });
+  });
+
+  const notReady: OrderStatus[] = ['WAITING_CONFIRMATION', 'CONFIRMED', 'PREPARING', 'PACKING', 'COMPLETED', 'CANCELLED', 'EXPIRED'];
+  it.each(notReady)('does not announce an initial %s order', status => {
+    expect(pickupDialogs(receive(order(status)))).toHaveLength(0);
+    expect(shared.play).not.toHaveBeenCalled();
+  });
+  it.each(notReady)('closes after READY becomes %s and does not resurrect an old alert', status => {
+    expect(pickupDialogs(receive(order()))).toHaveLength(1);
+    expect(pickupDialogs(receive(order(status)))).toHaveLength(0);
+    expect(pickupDialogs(receive(order()))).toHaveLength(0);
+    expect(shared.play).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(['DINE_IN', 'DELIVERY'] as const)('never announces an initial %s READY order', fulfillment => {
+    expect(pickupDialogs(receive(order('READY', fulfillment)))).toHaveLength(0);
+    expect(shared.play).not.toHaveBeenCalled();
+  });
+  it.each(['DINE_IN', 'DELIVERY'] as const)('clears the old alert on a %s transition before returning to TAKEOUT', fulfillment => {
+    receive(order());
+    expect(pickupDialogs(receive(order('READY', fulfillment)))).toHaveLength(0);
+    expect(pickupDialogs(receive(order()))).toHaveLength(0);
+    expect(shared.play).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps an explicitly dismissed alert closed through duplicate READY updates', () => {
+    const dialog = pickupDialogs(receive(order()))[0];
+    const dismiss = elements(dialog).find(element => element.type === 'button' && typeof element.props['aria-label'] === 'string');
+    click(dismiss!);
+    expect(pickupDialogs(render())).toHaveLength(0);
+    expect(pickupDialogs(receive(order()))).toHaveLength(0);
+    expect(shared.play).toHaveBeenCalledTimes(1);
+  });
+
+  it('announces a different READY order with its own code', () => {
+    receive(order());
+    const tree = receive({ ...order(), orderNo: 'SYNTHETIC-PICKUP-0002', pickupVerificationCode: '3579' });
+    expect(pickupDialogs(tree)).toHaveLength(1);
+    const code = elements(tree).find(element => element.props['data-testid'] === 'pickup-ready-dialog-code');
+    expect(text(code!.props.children as ReactNode)).toBe('3579');
+    expect(shared.play).toHaveBeenCalledTimes(2);
+  });
+
+  it('does not render an empty pickup code', () => {
+    expect(pickupDialogs(receive({ ...order(), pickupVerificationCode: null }))).toHaveLength(0);
+  });
+
+  it('hides READY after successful local cancellation, even if READY arrived while DELETE was pending', async () => {
+    const waitingTree = receive(order('WAITING_CONFIRMATION'));
+    const cancelButton = elements(waitingTree).find(element => element.type === 'button'
+      && text(element.props.children as ReactNode) === publicOrderMessages.get('zh-TW', 'cancelOrder'));
+    click(cancelButton!);
+    const cancelDialog = elements(render()).find(element => element.type === PublicOrderCancelDialog);
+    expect(cancelDialog).toBeDefined();
+    let resolveDelete!: (response: Response) => void;
+    const fetchMock = vi.fn(() => new Promise<Response>(resolve => { resolveDelete = resolve; }));
+    vi.stubGlobal('fetch', fetchMock);
+    (cancelDialog!.props.onConfirm as () => void)();
+    expect(fetchMock).toHaveBeenCalledWith('/api/public/orders/synthetic-tracking-token', expect.objectContaining({ method: 'DELETE' }));
+    expect(pickupDialogs(receive(order()))).toHaveLength(1);
+
+    resolveDelete(Response.json({ orderStatus: 'CANCELLED' }));
+    await vi.waitFor(() => expect(shared.refresh).toHaveBeenCalledTimes(1));
+    const cancelledTree = render();
+    expect(text(cancelledTree)).toContain(publicOrderMessages.get('zh-TW', 'statusCancelled'));
+    expect(pickupDialogs(cancelledTree)).toHaveLength(0);
+    expect(pickupDialogs(receive(order()))).toHaveLength(0);
+    expect(shared.play).toHaveBeenCalledTimes(1);
+  });
+});
