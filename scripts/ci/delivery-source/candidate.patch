+  return public.create_public_order_with_fulfillment_time_targeted(
+    'ad200000-0000-4000-8000-000000000001', 'demo-aming-chicken-qr-2026-rotate-me',
+    repeat('s',64), repeat('d',64), repeat('i',64), repeat('q',64), repeat('b',64),
+    'ad210000-0000-4000-8000-000000000001', repeat('h',64),
+    'Synthetic delivery customer', '0900000000', 'Synthetic delivery address', '',
+    v_items, repeat('t',64), repeat('p',64), 'delivery-hours-targeted', true, p_requested, null
+  );
+end;
