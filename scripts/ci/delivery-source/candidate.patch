@@ -0,0 +1,113 @@
+-- Public delivery requires a merchant who can confirm the order now. A future
+-- requested delivery time does not defer the existing confirmation deadline.
+create function public.delivery_ordering_unavailable_code(
+  p_stall_id uuid, p_now timestamptz default now()
+)
+returns text
+language sql stable security definer set search_path = '' as $$
+  with local_clock as (
+    select p_now at time zone stall.timezone as local_now
+    from public.stalls stall where stall.id = p_stall_id
+  ), current_override as (
+    select closure.id
+    from public.stall_special_closures closure cross join local_clock clock
+    where closure.stall_id = p_stall_id
+      and clock.local_now::date between closure.starts_on and closure.ends_on
+    order by closure.starts_on, closure.id limit 1
+  ), active_window as (
+    select ordering_window.last_order_at, clock.local_now
+    from local_clock clock cross join generate_series(-1, 0) offset_day
+    cross join lateral app_private.stall_ordering_window(
+      p_stall_id, clock.local_now::date + offset_day
+    ) ordering_window
+    where clock.local_now >= ordering_window.opens_at and clock.local_now < ordering_window.closes_at
+      -- Special hours are same-day windows. Today's special date supersedes
+      -- the previous weekly overnight tail, including a full-day closure.
+      and (offset_day = 0 or not exists (select 1 from current_override))
+    order by ordering_window.opens_at desc limit 1
+  )
+  select case
+    when not exists (select 1 from active_window) then 'DELIVERY_OUTSIDE_ORDERING_HOURS'
+    when (select local_now >= last_order_at from active_window) then 'QR_LAST_ORDER_PASSED'
+    else null
+  end;
+$$;
+revoke all on function public.delivery_ordering_unavailable_code(uuid,timestamptz)
+  from public, anon, authenticated;
+grant execute on function public.delivery_ordering_unavailable_code(uuid,timestamptz)
+  to service_role;
+
+-- Calculate the new schedule result at the established check point. The
+-- canonical function still returns resumable/idempotent orders before denial.
+do $migration$
+declare
+  v_oid regprocedure := 'public.public_order_preflight(text,text,text,text,text,text,text,text,text,uuid,text,timestamptz,uuid,jsonb,boolean,text)'::regprocedure;
+  v_source text := pg_get_functiondef(v_oid);
+  v_anchor text := '  v_schedule_code := public.validate_ordering_schedule_context(v_qr.id, v_ordering_mode);';
+begin
+  if (length(v_source) - length(replace(v_source, v_anchor, ''))) / length(v_anchor) <> 1 then
+    raise exception 'DELIVERY_PREFLIGHT_ANCHOR_MISMATCH';
+  end if;
+  execute replace(v_source, v_anchor, v_anchor || E'\n'
+    || '  if v_schedule_code is null and v_ordering_mode = ''DELIVERY'' then' || E'\n'
+    || '    v_schedule_code := public.delivery_ordering_unavailable_code(v_qr.stall_id, now());' || E'\n'
+    || '  end if;');
+end;
+$migration$;
+
+-- New legacy/targeted sessions must enforce the same policy even when called
+-- directly by a trusted circuit. Existing outer session replay stays intact.
+do $migration$
+declare
+  v_oid regprocedure;
+  v_source text;
+  v_anchor text := '    v_code := public.validate_ordering_schedule_context(v_qr.id, p_ordering_mode);';
+begin
+  foreach v_oid in array array[
+    'public.issue_order_session_with_schedule(text,text,text,text,text,text,text,text)'::regprocedure,
+    'app_private.issue_order_session_with_schedule_targeted(text,text,text,text,text,text,text,text)'::regprocedure
+  ] loop
+    v_source := pg_get_functiondef(v_oid);
+    if (length(v_source) - length(replace(v_source, v_anchor, ''))) / length(v_anchor) <> 1 then
+      raise exception 'DELIVERY_SESSION_ANCHOR_MISMATCH: %', v_oid;
+    end if;
+    execute replace(v_source, v_anchor, v_anchor || E'\n'
+      || '    if v_code is null and p_ordering_mode = ''DELIVERY'' then' || E'\n'
+      || '      v_code := public.delivery_ordering_unavailable_code(v_qr.stall_id, clock_timestamp());' || E'\n'
+      || '    end if;');
+  end loop;
+end;
+$migration$;
+
+-- Every public delivery wrapper reaches this shared insert writer. Enforce
+-- the calendar after its replay/session/QR/manual-state checks and before any
+-- rate-limit consumption or order writes. Return the normal audited JSON error.
+do $migration$
+declare
+  v_oid regprocedure := 'public.create_public_order_legacy(uuid,text,text,text,text,text,text,uuid,text,text,text,jsonb,text,text,text)'::regprocedure;
+  v_source text := pg_get_functiondef(v_oid);
+  v_declaration text := '  v_existing jsonb;';
+  v_anchor text := '  if jsonb_typeof(p_items) <> ''array'' or jsonb_array_length(p_items) = 0 then';
+  v_guard text := $guard$  if v_session.ordering_mode = 'DELIVERY' then
+    v_delivery_code := public.delivery_ordering_unavailable_code(v_session.stall_id, clock_timestamp());
+    if v_delivery_code is not null then
+      perform public.record_public_order_attempt(
+        p_request_id, 'ORDER_SUBMIT', 'DENIED', v_delivery_code,
+        v_session.tenant_id, v_session.stall_id, v_session.qr_code_id,
+        v_session.id, p_ip_hash, p_device_hash, p_qr_token_hash,
+        p_session_token_hash, p_behavior_hash, p_idempotency_hash
+      );
+      return jsonb_build_object('ok', false, 'code', v_delivery_code);
+    end if;
+  end if;
+
+$guard$;
+begin
+  if (length(v_source) - length(replace(v_source, v_declaration, ''))) / length(v_declaration) <> 1
+    or (length(v_source) - length(replace(v_source, v_anchor, ''))) / length(v_anchor) <> 1 then
+    raise exception 'DELIVERY_WRITER_ANCHOR_MISMATCH';
+  end if;
+  v_source := replace(v_source, v_declaration, v_declaration || E'\n  v_delivery_code text;');
+  execute replace(v_source, v_anchor, v_guard || v_anchor);
+end;
