@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+import { publicOrderFunctionOrigin } from "./public-order-function-origin";
+
+const hostname = "stallorder-platform-review-ada76145-8663s-projects.vercel.app";
+const isolated = {
+  VERCEL_ENV: "preview",
+  LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED: "true",
+  PUBLIC_ORDER_FUNCTION_ORIGIN: "http://localhost:3001",
+  NEXT_PUBLIC_APP_URL: "http://localhost:3001",
+  DATABASE_URL: "postgresql://postgres:synthetic@127.0.0.1:54322/postgres?schema=public",
+  NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL: "http://127.0.0.1:54321/functions/v1",
+};
+describe("public order function Origin", () => {
+  it("allows explicitly isolated native Preview while retaining real provider and Production identity", () => {
+    expect(publicOrderFunctionOrigin(isolated)).toBe("http://localhost:3001");
+    expect(publicOrderFunctionOrigin({ ...isolated, VERCEL: "1", VERCEL_URL: hostname }))
+      .toBe(`https://${hostname}`);
+    expect(publicOrderFunctionOrigin({ ...isolated, VERCEL_ENV: "production",
+      PUBLIC_ORDER_FUNCTION_ORIGIN: "https://app.qidaigo.com" })).toBe("https://app.qidaigo.com");
+  });
+
+  it.each([
+    { LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED: undefined },
+    { LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED: "false" },
+    { VERCEL: "1" }, { VERCEL: "unexpected" }, { VERCEL_URL: "invalid" },
+    { PUBLIC_ORDER_FUNCTION_ORIGIN: "https://app.qidaigo.com" },
+    { PUBLIC_ORDER_FUNCTION_ORIGIN: "http://localhost:3001/path" },
+    { PUBLIC_ORDER_FUNCTION_ORIGIN: "http://name@localhost:3001" },
+    { NEXT_PUBLIC_APP_URL: "https://app.qidaigo.com" },
+    { NEXT_PUBLIC_APP_URL: "http://localhost:3002" },
+    { NEXT_PUBLIC_APP_URL: "http://localhost:3001?override=1" },
+    { DATABASE_URL: undefined },
+    { DATABASE_URL: "postgresql://postgres:synthetic@db.example/postgres" },
+    { DATABASE_URL: "http://127.0.0.1:54322/postgres" },
+    { DATABASE_URL: "postgresql://postgres:synthetic@127.0.0.1/postgres?host=db.example" },
+    { DATABASE_URL: "postgresql://postgres:synthetic@127.0.0.1/postgres?hostaddr=192.0.2.1" },
+    { NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL: undefined },
+    { NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL: "https://project.supabase.co/functions/v1" },
+    { NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL: "http://127.0.0.1:54321/elsewhere" },
+    { SUPABASE_FUNCTIONS_URL: "https://project.supabase.co/functions/v1" },
+    { SUPABASE_FUNCTIONS_URL: "invalid" },
+  ])("never uses the local opt-in with missing isolation or provider identity: %j", (override) => {
+    expect(() => publicOrderFunctionOrigin({ ...isolated, ...override }))
+      .toThrow("PUBLIC_ORDER_PREVIEW_ORIGIN_INVALID");
+  });
+
+  it("binds Preview to the provider deployment despite stale explicit or build configuration", () => {
+    expect(publicOrderFunctionOrigin({ VERCEL_ENV: "preview", VERCEL_URL: hostname,
+      PUBLIC_ORDER_FUNCTION_ORIGIN: "https://app.qidaigo.com", NEXT_PUBLIC_APP_URL: "http://127.0.0.1:3000",
+    })).toBe(`https://${hostname}`);
+  });
+
+  it.each([undefined, "", "app.qidaigo.com", "attacker.example", "https://" + hostname,
+    "user@" + hostname, hostname + ":443", hostname + "/", hostname + "?x=1", hostname + "#x",
+    hostname + "\n", " " + hostname, hostname + " ", hostname + "\u0000", hostname.toUpperCase(),
+    hostname + ".evil.example", "x." + hostname, "-bad.vercel.app", "bad-.vercel.app",
+    "a".repeat(64) + ".vercel.app",
+  ])("rejects noncanonical Preview identity %j without fallback", (value) => {
+    expect(() => publicOrderFunctionOrigin({ VERCEL_ENV: "preview", VERCEL_URL: value,
+      PUBLIC_ORDER_FUNCTION_ORIGIN: "https://app.qidaigo.com", NEXT_PUBLIC_APP_URL: "http://127.0.0.1:3000",
+    })).toThrow("PUBLIC_ORDER_PREVIEW_ORIGIN_INVALID");
+  });
+
+  it("preserves Production precedence and local configuration", () => {
+    expect(publicOrderFunctionOrigin({ VERCEL_ENV: "production", VERCEL_URL: hostname,
+      PUBLIC_ORDER_FUNCTION_ORIGIN: "https://app.qidaigo.com/path", NEXT_PUBLIC_APP_URL: "https://unused.example",
+    })).toBe("https://app.qidaigo.com");
+    expect(publicOrderFunctionOrigin({ NEXT_PUBLIC_APP_URL: "http://127.0.0.1:3000/path" }))
+      .toBe("http://127.0.0.1:3000");
+    expect(publicOrderFunctionOrigin({})).toBe("https://app.qidaigo.com");
+    expect(() => publicOrderFunctionOrigin({ PUBLIC_ORDER_FUNCTION_ORIGIN: "invalid" })).toThrow();
+  });
+});
diff --git a/src/lib/public-order-function-origin.ts b/src/lib/public-order-function-origin.ts
new file mode 100644
index 0000000000000000000000000000000000000000..670d237a63e08b1de81043e03962a4ab504fbd7e
--- /dev/null
+++ b/src/lib/public-order-function-origin.ts
@@ -0,0 +1,68 @@
+type PublicOrderOriginEnvironment = {
+  VERCEL?: string;
+  VERCEL_ENV?: string;
+  VERCEL_URL?: string;
+  LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED?: string;
+  DATABASE_URL?: string;
+  SUPABASE_FUNCTIONS_URL?: string;
+  NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL?: string;
+  PUBLIC_ORDER_FUNCTION_ORIGIN?: string;
+  NEXT_PUBLIC_APP_URL?: string;
+};
+
+function isolatedLocalOrigin(environment: PublicOrderOriginEnvironment) {
+  if (environment.LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED !== "true"
+    || environment.VERCEL || environment.VERCEL_URL) return null;
+  try {
+    const origin = new URL(environment.PUBLIC_ORDER_FUNCTION_ORIGIN ?? "");
+    const app = new URL(environment.NEXT_PUBLIC_APP_URL ?? "");
+    const database = new URL(environment.DATABASE_URL ?? "");
+    const functions = new URL(environment.SUPABASE_FUNCTIONS_URL
+      || environment.NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL || "");
+    if (![origin, app, database, functions].every(url =>
+      ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname))
+      || ![origin, app, functions].every(url => url.protocol === "http:"
+        && !url.username && !url.password && !url.search && !url.hash)
+      || !["postgres:", "postgresql:"].includes(database.protocol)
+      || database.hash || [...database.searchParams.keys()].some(key => key !== "schema")
+      || origin.origin !== app.origin
+      || origin.pathname !== "/" || app.pathname !== "/"
+      || !["/functions/v1", "/functions/v1/"].includes(functions.pathname)) return null;
+    return origin.origin;
+  } catch {
+    return null;
+  }
+}
+
+export function publicOrderFunctionOrigin(environment: PublicOrderOriginEnvironment = {
+  VERCEL: process.env.VERCEL,
+  VERCEL_ENV: process.env.VERCEL_ENV,
+  VERCEL_URL: process.env.VERCEL_URL,
+  LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED: process.env.LOCAL_QA_PUBLIC_ORDER_ORIGIN_ENABLED,
+  DATABASE_URL: process.env.DATABASE_URL,
+  SUPABASE_FUNCTIONS_URL: process.env.SUPABASE_FUNCTIONS_URL,
+  NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL: process.env.NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL,
+  PUBLIC_ORDER_FUNCTION_ORIGIN: process.env.PUBLIC_ORDER_FUNCTION_ORIGIN,
+  NEXT_PUBLIC_APP_URL: process.env.NEXT_PUBLIC_APP_URL,
+}) {
+  if (environment.VERCEL_ENV === "preview") {
+    // Native E2E retains Preview auth/payment policies, but never a hosted target.
+    const localOrigin = isolatedLocalOrigin(environment);
+    if (localOrigin) return localOrigin;
+    // Vercel supplies this deployment identity. Never derive it from request
+    // Host or fall back to an unrelated Production/local origin in Preview.
+    const hostname = environment.VERCEL_URL;
+    if (!hostname || !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.vercel\.app$/.test(hostname)) {
+      throw new Error("PUBLIC_ORDER_PREVIEW_ORIGIN_INVALID");
+    }
+    return `https://${hostname}`;
+  }
+
+  const configured = environment.PUBLIC_ORDER_FUNCTION_ORIGIN || environment.NEXT_PUBLIC_APP_URL;
+  if (!configured) return "https://app.qidaigo.com";
+  try {
+    return new URL(configured).origin;
+  } catch {
+    throw new Error("PUBLIC_ORDER_FUNCTION_ORIGIN or NEXT_PUBLIC_APP_URL must be a valid URL.");
+  }
+}
