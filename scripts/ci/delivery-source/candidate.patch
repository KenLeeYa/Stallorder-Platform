+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import { LocaleProvider } from "@/components/locale-provider";
+import { useQrOrderFlowController, type QrOrderFlowControllerInput } from "@/components/qr-order-flow-controller";
+import { QrOrderFlowPresentation } from "@/components/qr-order-flow-presentation";
+import { deliveryOrderMessages } from "@/lib/delivery-order-i18n";
+import { qrOrderMessages } from "@/lib/qr-order-i18n";
+import type { PublicMenu } from "@/lib/public-menu-types";
+
+const menu: PublicMenu = {
+  orderingMode: "DELIVERY",
+  orderingOpenNow: false,
+  onlineMenuPath: "/store/test-stall",
+  preorderSlots: ["2099-10-29T06:00:00.000Z"],
+  lotteryEnabled: false,
+  deliveryNotice: "請確認外送地址。",
+  stall: { name: "測試店家", slug: "test-stall", location: "台中", currency: "TWD", timezone: "Asia/Taipei", fulfillmentType: "DELIVERY", table: null },
+  products: [{ id: "product-1", name: "測試餐點", description: "", price: 100, kind: "SINGLE", category: "主餐", rank: null, isBestSeller: false, isSoldOut: false, isOrderDiscountEligible: true, imageUrl: null, translations: [], noteGroups: [], bundleChoiceGroups: [] }],
+  supportedLocales: ["zh-TW"],
+  estimatedWaitMinutes: 10,
+  estimatedWaitMinMinutes: 5,
+  estimatedWaitMaxMinutes: 10,
+  waitAcknowledgmentThresholdMinutes: null,
+  requiresWaitAcknowledgment: false,
+  lastTableOrderAt: null,
+  limits: { maxItemQuantity: 5, maxUniqueProducts: 5, maxTotalQuantity: 10, maxNoteLength: 300 },
+};
+
+function renderFlow(overrides: Partial<QrOrderFlowControllerInput> = {}, message = "") {
+  const renderedControllers: Array<ReturnType<typeof useQrOrderFlowController>> = [];
+  function Flow() {
+    const controller = useQrOrderFlowController({ qrToken: "delivery-token", orderingMode: "DELIVERY", entryChannel: "SHARED_LINK", initialMenu: menu, ...overrides });
+    renderedControllers.push(controller);
+    return <QrOrderFlowPresentation controller={{ ...controller, message }} />;
+  }
+  const html = renderToStaticMarkup(<LocaleProvider initialLocale="zh-TW" hasLocaleCookie><Flow /></LocaleProvider>);
+  const controller = renderedControllers[0];
+  if (!controller) throw new Error("Controller did not render");
+  return { html, controller };
+}
+
+describe("delivery ordering hours in the public order flow", () => {
+  it.each([false, undefined])("blocks a shared delivery link with orderingOpenNow=%s, even with a future delivery slot", (orderingOpenNow) => {
+    const { html, controller } = renderFlow({ initialMenu: { ...menu, orderingOpenNow } });
+    expect(controller.outsideBusinessHours).toBe(true);
+    expect(controller.orderingEnabled).toBe(false);
+    expect(html).toContain('role="alertdialog"');
+    expect(html).toContain(deliveryOrderMessages["zh-TW"].outsideBusinessHours);
+    expect(html).not.toContain(qrOrderMessages["zh-TW"].outsideBusinessHoursAction);
+    expect(html).not.toContain(deliveryOrderMessages["zh-TW"].noticeDismiss);
+  });
+
+  it("keeps the reason inline beside disabled controls without offering a pickup redirect", () => {
+    const { html, controller } = renderFlow();
+    expect(controller.outsideBusinessHours).toBe(true);
+    expect(html).toContain('data-testid="delivery-ordering-hours"');
+    expect(html).toContain(deliveryOrderMessages["zh-TW"].outsideBusinessHours);
+    expect(html).toMatch(/<div role="status" data-testid="delivery-ordering-hours"/);
+    expect(html).toMatch(/<button[^>]+aria-label="增加 測試餐點"[^>]+disabled=""/);
+    expect(html).not.toContain(qrOrderMessages["zh-TW"].outsideBusinessHoursAction);
+  });
+
+  it("shows only one dialog when session admission reports the same closed delivery window", () => {
+    const { html } = renderFlow({}, deliveryOrderMessages["zh-TW"].outsideBusinessHours);
+    expect(html.match(/role="alertdialog"/g)).toHaveLength(1);
+    expect(html).toContain('data-testid="delivery-ordering-hours"');
+    expect(html).not.toContain(deliveryOrderMessages["zh-TW"].noticeDismiss);
+  });
+
+  it("allows the ordinary delivery notice when the authoritative admission window is open", () => {
+    const { html, controller } = renderFlow({ initialMenu: { ...menu, orderingOpenNow: true } });
+    expect(controller.outsideBusinessHours).toBe(false);
+    expect(html).toContain(deliveryOrderMessages["zh-TW"].noticeDismiss);
+    expect(html).not.toContain(deliveryOrderMessages["zh-TW"].outsideBusinessHours);
+  });
+
+  it("preserves QR closure handling and the takeout preorder policy", () => {
+    const qrMenu: PublicMenu = { ...menu, orderingMode: "DEFAULT", stall: { ...menu.stall, fulfillmentType: "TAKEOUT" } };
+    const qr = renderFlow({ orderingMode: "DEFAULT", entryChannel: "QR", initialMenu: qrMenu });
+    expect(qr.controller.outsideBusinessHours).toBe(true);
+    expect(qr.html).toContain(qrOrderMessages["zh-TW"].outsideBusinessHoursAction);
+    const preorder = renderFlow({ orderingMode: "PREORDER", initialMenu: { ...qrMenu, orderingMode: "PREORDER" } });
+    expect(preorder.controller.outsideBusinessHours).toBe(false);
+    expect(preorder.html).not.toContain(deliveryOrderMessages["zh-TW"].outsideBusinessHours);
+  });
+
+  it("does not apply new-order admission to editing an existing delivery order", () => {
+    expect(renderFlow({ editTrackingToken: "existing-order" }).controller.outsideBusinessHours).toBe(false);
+  });
+});
