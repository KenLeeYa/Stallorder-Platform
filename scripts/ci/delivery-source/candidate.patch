index 0000000000000000000000000000000000000000..f6fac942026670217d1e7380d16e56f9a21e020a
--- /dev/null
+++ b/src/lib/delivery-order-i18n.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from "vitest";
+import { localizedDeliveryOrderError } from "./delivery-order-i18n";
+import { errorMessage, statusForCode } from "../../supabase/functions/_shared/public-order-errors";
+
+describe("delivery admission errors", () => {
+  it("reports a closed delivery window as a conflict with delivery guidance", () => {
+    expect(statusForCode("DELIVERY_OUTSIDE_ORDERING_HOURS")).toBe(409);
+    expect(errorMessage("DELIVERY_OUTSIDE_ORDERING_HOURS")).toContain("外送接單");
+  });
+
+  it.each(["zh-TW", "en", "ja", "ko", "vi", "th"] as const)("localizes delivery closure and cutoff in %s", (locale) => {
+    const closed = localizedDeliveryOrderError(locale, "DELIVERY_OUTSIDE_ORDERING_HOURS", "DELIVERY");
+    const cutoff = localizedDeliveryOrderError(locale, "QR_LAST_ORDER_PASSED", "DELIVERY");
+    expect(closed).toBeTypeOf("string");
+    expect(cutoff).toBeTypeOf("string");
+    expect(closed!.length).toBeGreaterThan(20);
+    expect(cutoff!.length).toBeGreaterThan(20);
+    expect(localizedDeliveryOrderError(locale, "QR_LAST_ORDER_PASSED", "DEFAULT")).toBeNull();
+  });
+});
