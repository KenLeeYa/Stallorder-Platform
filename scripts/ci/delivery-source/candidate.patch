diff --git a/scripts/lib/production-json-file.mjs b/scripts/lib/production-json-file.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6632772902925b26384fe04a2ed92280add6864c
--- /dev/null
+++ b/scripts/lib/production-json-file.mjs
@@ -0,0 +1,38 @@
+import fs from "node:fs/promises";
+import { constants } from "node:fs";
+
+const MAX_BYTES = 64 * 1_024;
+
+export async function readProductionJsonFile(path, invalidReason) {
+  try {
+    const inspected = await fs.lstat(path);
+    if (!inspected.isFile() || inspected.size > MAX_BYTES) throw new Error(invalidReason);
+    const handle = await fs.open(path,
+      constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0) | (constants.O_NONBLOCK ?? 0));
+    try {
+      const before = await handle.stat();
+      if (!before.isFile() || before.size > MAX_BYTES
+          || before.dev !== inspected.dev || before.ino !== inspected.ino) {
+        throw new Error(invalidReason);
+      }
+      // Read the inspected handle, with one extra byte to detect growth at the limit.
+      const bytes = Buffer.alloc(MAX_BYTES + 1);
+      let length = 0;
+      while (length < bytes.length) {
+        const { bytesRead } = await handle.read(bytes, length, bytes.length - length, null);
+        if (bytesRead === 0) break;
+        length += bytesRead;
+      }
+      const after = await handle.stat();
+      if (length > MAX_BYTES || length !== before.size || after.size !== before.size
+          || after.mtimeMs !== before.mtimeMs || after.ctimeMs !== before.ctimeMs) {
+        throw new Error(invalidReason);
+      }
+      return JSON.parse(bytes.subarray(0, length).toString("utf8"));
+    } finally {
+      await handle.close();
+    }
+  } catch {
+    throw new Error(invalidReason);
+  }
+}
