index 0000000000000000000000000000000000000000..bff3960dd49cddf5d9a38eb08c83fc452c27b9ea
--- /dev/null
+++ b/src/components/completed-orders-panel.expired.test.tsx
@@ -0,0 +1,160 @@
+import { Children, isValidElement, type ReactElement, type ReactNode } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { AppLocale } from "@/lib/app-locale";
+import { formatAppDateTime } from "@/lib/locale-format";
+import { createOperationsTranslator, getOperationsMessage } from "@/lib/messages/operations";
+
+const hooks = vi.hoisted(() => ({ values: [] as unknown[], cursor: 0, locale: "zh-TW" as AppLocale }));
+
+vi.mock("react", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("react")>();
+  return {
+    ...actual,
+    useCallback: <T extends (...args: never[]) => unknown>(callback: T) => callback,
+    useState: <T,>(initial: T | (() => T)) => {
+      const index = hooks.cursor++;
+      if (!(index in hooks.values)) hooks.values[index] = typeof initial === "function" ? (initial as () => T)() : initial;
+      return [hooks.values[index] as T, (next: T | ((current: T) => T)) => {
+        hooks.values[index] = typeof next === "function" ? (next as (current: T) => T)(hooks.values[index] as T) : next;
+      }];
+    },
+  };
+});
+
+vi.mock("@/components/operations-locale", () => ({
+  useOperationsLocale: () => ({ locale: hooks.locale, t: createOperationsTranslator(hooks.locale) }),
+}));
+
+import { CompletedOrdersPanel } from "./completed-orders-panel";
+
+const expiredOrder = {
+  id: "33333333-3333-4333-8333-333333333333",
+  orderNo: "261029-999",
+  customerName: "測試顧客",
+  customerPhone: null,
+  fulfillmentType: "DELIVERY",
+  tableLabel: null,
+  status: "EXPIRED",
+  paymentStatus: "UNPAID",
+  subtotal: 120,
+  discountAmount: 0,
+  discountLabel: null,
+  total: 120,
+  note: null,
+  createdAt: "2026-10-29T00:41:16.000Z",
+  completedAt: null,
+  cancelledAt: null,
+  expiredAt: "2026-10-29T00:52:00.000Z",
+  cancellationReason: null,
+  cancellationDetail: null,
+  payment: null,
+  items: [{ id: "item-1", name: "測試餐點", quantity: 1, unitPrice: 120, note: null, noteOptions: [] }],
+};
+
+type ElementProps = {
+  children?: ReactNode;
+  "aria-expanded"?: boolean;
+  "aria-label"?: string;
+  "data-testid"?: string;
+  onClick?: () => void;
+  onChange?: (event: { target: { value: string } }) => void;
+  onSubmit?: (event: { preventDefault: () => void }) => void;
+};
+
+function findElement(node: ReactNode, matches: (element: ReactElement<ElementProps>) => boolean): ReactElement<ElementProps> {
+  for (const child of Children.toArray(node)) {
+    if (!isValidElement<ElementProps>(child)) continue;
+    if (matches(child)) return child;
+    try { return findElement(child.props.children, matches); } catch { /* Continue with the next sibling. */ }
+  }
+  throw new Error("Expected UI control was not rendered.");
+}
+
+function renderPanel() {
+  hooks.cursor = 0;
+  return CompletedOrdersPanel({ stallSlug: "demo", currency: "TWD", requiresAuthorizationCode: true, canPrintReceipt: true });
+}
+
+async function openHistory() {
+  findElement(renderPanel(), (element) => element.type === "button").props.onClick!();
+  await vi.waitFor(() => expect(renderToStaticMarkup(renderPanel())).toContain(expiredOrder.orderNo));
+}
+
+function expandOrder() {
+  findElement(renderPanel(), (element) => element.type === "button" && renderToStaticMarkup(element).includes(`#${expiredOrder.orderNo}`)).props.onClick!();
+  return renderToStaticMarkup(renderPanel());
+}
+
+const fetchMock = vi.fn();
+
+describe("expired orders in Staff history", () => {
+  beforeEach(() => {
+    hooks.values = [];
+    hooks.cursor = 0;
+    hooks.locale = "zh-TW";
+    fetchMock.mockReset().mockImplementation(async () => Response.json({ orders: [expiredOrder], paymentOptions: [] }));
+    vi.stubGlobal("fetch", fetchMock);
+  });
+
+  afterEach(() => { vi.unstubAllGlobals(); });
+
+  it.each(["zh-TW", "en", "ja", "ko", "vi", "th"] as const)("explains expiry and keeps the order read-only in %s", async (locale) => {
+    hooks.locale = locale;
+    await openHistory();
+    expandOrder();
+    const html = renderToStaticMarkup(findElement(renderPanel(), (element) => element.type === "article"));
+
+    expect(html).toContain(getOperationsMessage(locale, "completedOrders.expired"));
+    expect(html).not.toContain(getOperationsMessage(locale, "completedOrders.cancelled"));
+    expect(html).toContain(getOperationsMessage(locale, "completedOrders.expiredWarning"));
+    expect(html).toContain(formatAppDateTime(locale, expiredOrder.expiredAt, { dateStyle: "short", timeStyle: "short" }));
+    expect(html).toContain("測試餐點");
+    expect(html).not.toContain(getOperationsMessage(locale, "completedOrders.cancelledPaymentWarning"));
+    for (const action of ["change-payment", "cancel", "print"]) {
+      expect(html).not.toContain(`data-testid="completed-order-${action}"`);
+    }
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(fetchMock).toHaveBeenCalledWith("/api/stalls/demo/completed-orders?query=&status=ALL", { cache: "no-store" });
+  });
+
+  it("offers an expired filter and sends it with the search without mutations", async () => {
+    await openHistory();
+    expect(renderToStaticMarkup(renderPanel())).toContain('<option value="EXPIRED">已逾期</option>');
+    findElement(renderPanel(), (element) => element.type === "select").props.onChange!({ target: { value: "EXPIRED" } });
+    findElement(renderPanel(), (element) => element.type === "input").props.onChange!({ target: { value: expiredOrder.orderNo } });
+    const preventDefault = vi.fn();
+    findElement(renderPanel(), (element) => element.type === "form").props.onSubmit!({ preventDefault });
+
+    await vi.waitFor(() => expect(fetchMock).toHaveBeenCalledTimes(2));
+    expect(preventDefault).toHaveBeenCalledOnce();
+    expect(fetchMock).toHaveBeenLastCalledWith(`/api/stalls/demo/completed-orders?query=${expiredOrder.orderNo}&status=EXPIRED`, { cache: "no-store" });
+  });
+
+  it("preserves completed correction actions and cancelled-order explanation", async () => {
+    fetchMock.mockImplementation(async () => Response.json({ orders: [{ ...expiredOrder, status: "COMPLETED", expiredAt: null, completedAt: expiredOrder.expiredAt }], paymentOptions: [] }));
+    await openHistory();
+    const completedHtml = expandOrder();
+    for (const action of ["change-payment", "cancel", "print"]) {
+      expect(completedHtml).toContain(`data-testid="completed-order-${action}"`);
+    }
+
+    fetchMock.mockImplementation(async () => Response.json({ orders: [{ ...expiredOrder, status: "CANCELLED", expiredAt: null, cancelledAt: expiredOrder.expiredAt }], paymentOptions: [] }));
+    findElement(renderPanel(), (element) => element.type === "form").props.onSubmit!({ preventDefault: vi.fn() });
+    await vi.waitFor(() => expect(renderToStaticMarkup(renderPanel())).toContain(getOperationsMessage("zh-TW", "completedOrders.cancelledPaymentWarning")));
+    expect(renderToStaticMarkup(renderPanel())).not.toContain('data-testid="completed-order-cancel"');
+  });
+
+  it("hides a pending completed-order correction if a refresh returns the order as expired", async () => {
+    fetchMock.mockImplementationOnce(async () => Response.json({ orders: [{ ...expiredOrder, status: "COMPLETED", expiredAt: null, completedAt: expiredOrder.expiredAt }], paymentOptions: [] }));
+    await openHistory();
+    expandOrder();
+    findElement(renderPanel(), (element) => element.props["data-testid"] === "completed-order-cancel").props.onClick!();
+    expect(renderToStaticMarkup(renderPanel())).toContain(getOperationsMessage("zh-TW", "completedOrders.confirmOrderNo"));
+    findElement(renderPanel(), (element) => element.type === "form").props.onSubmit!({ preventDefault: vi.fn() });
+
+    await vi.waitFor(() => expect(renderToStaticMarkup(renderPanel())).toContain(getOperationsMessage("zh-TW", "completedOrders.expiredWarning")));
+    expect(renderToStaticMarkup(renderPanel())).not.toContain(getOperationsMessage("zh-TW", "completedOrders.confirmOrderNo"));
+    expect(fetchMock.mock.calls.every(([, options]) => !options.method)).toBe(true);
+  });
+});
