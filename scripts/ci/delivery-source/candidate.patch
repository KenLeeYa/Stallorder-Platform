@@ -0,0 +1,52 @@
+import { NextResponse } from "next/server";
+import { logEvent } from "@/lib/audit";
+import { prisma } from "@/lib/prisma";
+import { authorizeHealthApiRequest, healthResponseHeaders } from "@/server/resilience/health-authorization";
+
+export const dynamic = "force-dynamic";
+
+type Principal = {
+  currentUser: string;
+  sessionUser: string;
+  database: string;
+  superuser: boolean;
+  bypassRls: boolean;
+  helperExists: boolean;
+  helperExecute: boolean | null;
+  observedAt: Date;
+};
+
+export async function GET(request: Request) {
+  // Diagnostics retain the normal request budget without collecting other identities' expired buckets.
+  const authorization = await authorizeHealthApiRequest(request, { rateLimitCleanup: "current-key" });
+  if (!authorization.ok) return authorization.response;
+  try {
+    const rows = await prisma.$queryRaw<Principal[]>`
+      SELECT current_user::text AS "currentUser", session_user::text AS "sessionUser",
+        current_database()::text AS "database", r.rolsuper AS "superuser", r.rolbypassrls AS "bypassRls",
+        to_regprocedure('public.delivery_ordering_unavailable_code(uuid,timestamptz)') IS NOT NULL AS "helperExists",
+        has_function_privilege(current_user,
+          to_regprocedure('public.delivery_ordering_unavailable_code(uuid,timestamptz)'), 'EXECUTE') AS "helperExecute",
+        statement_timestamp() AS "observedAt"
+      FROM pg_catalog.pg_roles r WHERE r.rolname = current_user
+    `;
+    const row = rows[0];
+    if (rows.length !== 1 || !row || ![row.currentUser, row.sessionUser, row.database]
+      .every(value => typeof value === "string" && value.length > 0)
+      || typeof row.superuser !== "boolean" || typeof row.bypassRls !== "boolean"
+      || typeof row.helperExists !== "boolean"
+      || (row.helperExists ? typeof row.helperExecute !== "boolean" : row.helperExecute !== null)
+      || !(row.observedAt instanceof Date) || !Number.isFinite(row.observedAt.getTime())) {
+      throw new Error("DATABASE_PRINCIPAL_RESULT_INVALID");
+    }
+    return NextResponse.json({ schema: "stallorder-database-principal/v1",
+      currentUser: row.currentUser, sessionUser: row.sessionUser, database: row.database,
+      superuser: row.superuser, bypassRls: row.bypassRls, helperExists: row.helperExists,
+      helperExecute: row.helperExecute, observedAt: row.observedAt.toISOString(),
+    }, { headers: healthResponseHeaders });
+  } catch {
+    logEvent("error", "DATABASE_PRINCIPAL_PROBE_FAILED", {});
+    return NextResponse.json({ error: "DATABASE_PRINCIPAL_UNAVAILABLE" },
+      { status: 503, headers: healthResponseHeaders });
+  }
+}
