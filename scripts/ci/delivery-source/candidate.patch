--- /dev/null
+++ b/scripts/lib/production-smoke-csp.mjs
@@ -0,0 +1,18 @@
+export function allowsTurnstile(csp) {
+  if (!csp.trim()) return false;
+  return csp.split(",").every((policy) => {
+    const directives = new Map();
+    for (const directive of policy.split(";")) {
+      const [name, ...sources] = directive.trim().split(/\s+/u);
+      const key = name.toLowerCase();
+      // Browsers use the first occurrence of a directive within each policy.
+      if (key && !directives.has(key)) directives.set(key, sources);
+    }
+    const scripts = directives.get("script-src-elem") ?? directives.get("script-src")
+      ?? directives.get("default-src") ?? [];
+    const frames = directives.get("frame-src") ?? directives.get("child-src")
+      ?? directives.get("default-src") ?? [];
+    return [scripts, frames].every((sources) =>
+      sources.includes("https://challenges.cloudflare.com") && !sources.includes("'none'"));
+  });
+}
