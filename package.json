{
  "name": "stallorder-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "optimize:inventory": "node scripts/awesome-optimization/cli.mjs inventory",
    "optimize:verify": "node scripts/awesome-optimization/cli.mjs verify",
    "optimize:external-check": "node scripts/awesome-optimization/cli.mjs external-check",
    "optimize:report": "node scripts/awesome-optimization/cli.mjs report",
    "dev:qa": "node scripts/start-local-qa.mjs",
    "qa:local": "node scripts/check-local-qa.mjs",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "catalog:translation:benchmark": "node --conditions=react-server --import tsx scripts/run-catalog-translation-benchmark.ts",
    "test:e2e": "concurrently --kill-others --success command-1 \"npm run functions:serve:e2e\" \"node scripts/run-playwright-shards.mjs\"",
    "test:e2e:resilience:production": "cross-env PLAYWRIGHT_PRODUCTION_SERVER=true PLAYWRIGHT_APP_URL=http://127.0.0.1:3000 PLAYWRIGHT_TRUSTED_CLIENT_IP=203.0.113.200 concurrently --kill-others --success command-1 \"npm run functions:serve:e2e\" \"playwright test e2e/offline-pwa-foundation.spec.ts e2e/qr-degraded-mode.spec.ts e2e/resilience-failure-injection.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "ui:audit": "node scripts/audit-ui-controls.mjs",
    "local:doctor": "node scripts/local-dev-doctor.mjs",
    "docker:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-desktop-health.ps1",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "production:check": "node scripts/production-readiness.mjs",
    "production:smoke": "node scripts/production-smoke-test.mjs",
    "auth:migration-report": "node scripts/report-oauth-migration-readiness.mjs",
    "billing:payg:production-audit": "tsx scripts/audit-payg-production.ts",
    "preview:catalog-translation-smoke": "node scripts/run-catalog-translation-preview-smoke.mjs",
    "preview:delivery-smoke": "node scripts/run-delivery-synthetic-smoke.mjs",
    "performance:measure": "node scripts/measure-response-time.mjs",
    "performance:bundles": "node scripts/audit-client-bundles.mjs",
    "domain:migration": "node scripts/cloudflare-domain-migration.mjs",
    "domain:migration:apply": "node scripts/cloudflare-domain-migration.mjs --apply",
    "registrar:nameservers": "node scripts/godaddy-nameserver-migration.mjs",
    "registrar:nameservers:apply": "node scripts/godaddy-nameserver-migration.mjs --apply",
    "secrets:sync": "node scripts/sync-local-secrets.mjs",
    "secrets:sync:apply": "node scripts/sync-local-secrets.mjs --apply",
    "platform:pro:check": "node scripts/apply-pro-platform-settings.mjs --check",
    "platform:pro:apply": "node scripts/apply-pro-platform-settings.mjs --apply",
    "dr:replication:plan": "node scripts/configure-dr-replication.mjs --source PRIMARY --target DR",
    "dr:readiness": "node scripts/check-dr-readiness.mjs --target DR",
    "dr:prepare": "node scripts/prepare-dr-failover.mjs --target DR",
    "dr:switch": "node scripts/switch-active-backend.mjs",
    "dr:validate": "node scripts/validate-active-backend.mjs",
    "dr:failback": "node scripts/prepare-primary-failback.mjs --target PRIMARY",
    "resilience:game-day": "node scripts/run-resilience-game-day.mjs",
    "status:plan": "node scripts/plan-status-page-deployment.mjs",
    "status:check": "wrangler deploy --config status-worker/wrangler.jsonc --dry-run --outdir .wrangler/status-dry-run",
    "status:deploy": "wrangler deploy --config status-worker/wrangler.jsonc",
    "github:rulesets:plan": "node scripts/configure-github-rulesets.mjs",
    "github:rulesets:apply": "node scripts/configure-github-rulesets.mjs --apply",
    "github:rulesets:rollback": "node scripts/configure-github-rulesets.mjs --rollback",
    "db:start": "supabase start",
    "db:push": "supabase db push",
    "db:seed": "cross-env ALLOW_DEMO_SEED=true tsx prisma/seed.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env --no-verify-jwt",
    "functions:serve:e2e": "supabase functions serve --env-file supabase/functions/e2e-runtime.defaults --no-verify-jwt",
    "mobile:lint": "npm run lint --workspace @stallorder/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @stallorder/mobile",
    "mobile:test": "npm run test --workspace @stallorder/mobile",
    "mobile:doctor": "npm run doctor --workspace @stallorder/mobile",
    "mobile:export": "npm run export --workspace @stallorder/mobile"
  },
  "dependencies": {
    "@line/liff": "2.31.0",
    "@pinyin-pro/data": "^1.3.1",
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/oidc": "3.8.4",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.4",
    "jsqr": "1.4.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "openai": "7.0.0",
    "papaparse": "^5.5.4",
    "pinyin-pro": "^3.28.2",
    "qrcode": "1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "web-push": "3.6.7",
    "zod": "^4.2.1",
    "@stallorder/contracts": "0.1.0"
  },
  "devDependencies": {
    "@actions/core": "1.11.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.118.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "postcss": "8.5.25",
    "sharp": "^0.35.4",
    "shell-quote": "^1.10.0",
    "@eslint/config-array@0.21.2": {
      "minimatch": "3.1.5"
    },
    "@eslint/eslintrc@3.3.6": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-import@2.32.0": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-jsx-a11y@6.10.2": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-react@7.37.5": {
      "minimatch": "3.1.5"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "@typescript-eslint/typescript-estree@8.63.0": {
      "minimatch": "10.2.5"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "miniflare@5.20260730.0-alpha": {
      "undici": "7.29.1"
    },
    "@actions/http-client@2.2.3": {
      "undici": "7.29.1"
    },
    "eslint@^9": {
      "minimatch": "3.1.5"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    },
    "debug@^4": "4.4.3"
  },
  "workspaces": [
    "apps/mobile",
    "packages/contracts"
  ]
}
