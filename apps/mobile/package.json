{
  "name": "@stallorder/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "export": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run doctor && npm run export"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@stallorder/contracts": "0.1.0",
    "@tanstack/react-query": "5.104.0",
    "expo": "57.0.16",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.2",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.16",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "react": "19.2.4",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "babel-preset-expo": "57.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  }
}
