{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes npm@11.16.0 ci --workspace packages/contracts --include-workspace-root --include=dev && node scripts/verify-web-install-scope.mjs",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "staging": false,
      "codex/integrated-production-20261002": false,
      "codex/line-platform-oa-v2-20260927": false
    }
  },
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/line-pay-recovery",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/staff-push",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/delivery-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/outbox-dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/storage-replication",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/payg-close",
      "schedule": "15 * * * *"
    }
  ]
}
